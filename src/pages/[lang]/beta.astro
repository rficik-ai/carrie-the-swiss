---
// Beta: the homepage as one film, continued as a walk through Carrie's house. Not indexed until approved.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Episodes from '../../components/Episodes.astro';
import PhotoWall from '../../components/PhotoWall.astro';
import WallStop from '../../components/WallStop.astro';
import DeskStop from '../../components/DeskStop.astro';
import GardenStop from '../../components/GardenStop.astro';
import FireStop from '../../components/FireStop.astro';
import DoorStop from '../../components/DoorStop.astro';
import Follow from '../../components/Follow.astro';
import Footer from '../../components/Footer.astro';
import { availableLocales, t, type Locale } from '../../i18n';

export function getStaticPaths() {
  return availableLocales().map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
const s = t(locale);
---
<Base locale={locale} title={s.meta.title} description={s.meta.description} path="beta/" noindex>
  <Header locale={locale} page="beta/" />
  <main>
    <Hero locale={locale} house>
      <div class="after" slot="after">
        <Follow locale={locale} />
        <Footer locale={locale} />
      </div>
    </Hero>
    <Episodes locale={locale} />
    <PhotoWall locale={locale} />
    <WallStop locale={locale} />
    <DeskStop locale={locale} />
    <GardenStop locale={locale} />
    <FireStop locale={locale} />
    <DoorStop locale={locale} />
  </main>
  <style>
    /* the last part of the page scrolls up over the night scene at the front door */
    .after { position: relative; z-index: 8; background: linear-gradient(180deg, rgba(13,12,10,0) 0, rgba(13,12,10,.82) 38vh, #0d0c0a 70vh); padding-top: 45vh; }
    .after :global(.follow) { background: none; }
  </style>
</Base>
