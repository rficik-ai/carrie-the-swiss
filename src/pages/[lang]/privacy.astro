---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SubHero from '../../components/SubHero.astro';
import { availableLocales, t, type Locale } from '../../i18n';
import { PRIVACY, CONTACT } from '../../data/privacy';

export function getStaticPaths() {
  return availableLocales().map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
const p = PRIVACY[locale] ?? PRIVACY.en!;
const back = (t(locale) as any).sub.back as string;
// the contact address becomes a link wherever it appears
const parts = (text: string) => text.split(CONTACT);
// "Effective 5 November 2026" → label "Effective", value "5 November 2026"
const upd: [string, string] = [p.updated.replace(/:?\s*\d.*$/, ''), p.updated.match(/\d.*$/)?.[0] ?? ''];
---
<Base locale={locale} title={`${p.title} · Carrie the Swiss`} description={p.meta} path="privacy/">
  <Header locale={locale} page="privacy/" />
  <main class="priv">
    <SubHero kicker="Carrie the Swiss" title={p.title} lead={p.intro} back={{ href: `/${locale}/`, label: back }} meta={[[upd[0], upd[1]]]}>
      <div class="body">
        {p.sections.map((s, i) => (
          <article>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="statement sm">{s.h}</h2>
            <div class="txt">
              {s.p.map((para) => (
                <p>{parts(para).map((bit, j) => (<>{j > 0 && <a href={`mailto:${CONTACT}`}>{CONTACT}</a>}{bit}</>))}</p>
              ))}
            </div>
          </article>
        ))}
      </div>
    </SubHero>
  </main>
  <Footer locale={locale} />
</Base>

<style>
  .priv { background: var(--ink); }
  .body { display: grid; }
  article { display: grid; gap: 14px 32px; padding: clamp(28px, 3.5vw, 52px) 0; border-bottom: 1px solid rgba(244,238,226,.18); }
  @media (min-width: 900px) { article { grid-template-columns: 70px minmax(0, 1fr) minmax(0, 1.25fr); } }
  .n { font: 300 clamp(18px, 1.6vw, 24px)/1.2 var(--f-head); color: var(--gold); }
  h2 { color: #fff; max-width: 14em; }
  .txt { display: grid; gap: 14px; }
  .txt p { font-size: 16px; line-height: 1.7; color: #e3dccd; max-width: 62ch; }
  .txt a { color: var(--gold-hi); text-underline-offset: 3px; }
</style>
