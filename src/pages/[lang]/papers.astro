---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import SubHero from '../../components/SubHero.astro';
import Guide from '../../components/Guide.astro';
import Footer from '../../components/Footer.astro';
import { availableLocales, t, type Locale } from '../../i18n';

export function getStaticPaths() {
  return availableLocales().map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
const s = t(locale);
const sub = (s as any).sub;
const r = s.real;
const stats: [string, string][] = [
  [r.height, '63.5 cm'], [r.hips, 'A / A'], [r.elbows, '0 / 0'], [r.character, '14 / 14'], [r.show, r.show_value],
];
---
<Base locale={locale} title={sub.meta_title} description={sub.meta_description} path="papers/">
  <Header locale={locale} page="papers/" />
  <main>
    <SubHero kicker={r.eyebrow} title={sub.title} lead={sub.intro} back={{ href: `/${locale}/#episodes`, label: sub.back }} meta={[[r.standard, '58'], [r.approved, '✓']]}>
      <div class="pair" data-reveal>
        <figure class="shot">
          <div class="card-media"><img src="/assets/img/carrie-real.jpg" alt={r.photo_caption} width="1200" height="1500" /></div>
          <figcaption><span class="cap-k">{r.eyebrow}</span><span class="cap-t">{r.photo_caption}</span></figcaption>
        </figure>
        <div class="results card-media">
          <p class="cap-k">{sub.results}</p>
          <dl>
            {stats.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          </dl>
        </div>
      </div>
    </SubHero>
    <Guide locale={locale} />
  </main>
  <Footer locale={locale} />
</Base>

<style>
  .pair { display: grid; gap: clamp(20px, 2.5vw, 36px); }
  @media (min-width: 860px) { .pair { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: stretch; } }
  .shot { margin: 0; display: grid; gap: 14px; align-content: start; }
  .shot .card-media { aspect-ratio: 4 / 5; }
  figcaption { display: grid; gap: 4px; }
  figcaption .cap-k { color: var(--muted-dark); }
  figcaption .cap-t { color: #fff; }
  .results { padding: clamp(24px, 3vw, 44px); display: grid; align-content: center; gap: 22px; box-shadow: inset 0 0 0 1px rgba(234,211,154,.18); }
  .results .cap-k { color: var(--gold); }
  dl { margin: 0; }
  dl div { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 16px 0; border-top: 1px solid rgba(244,238,226,.18); }
  dt { font: 300 14px/1.3 var(--f-head); letter-spacing: .08em; text-transform: uppercase; color: var(--ivory); }
  dd { margin: 0; font: 300 clamp(26px, 2.6vw, 40px)/1 var(--f-head); letter-spacing: -.01em; color: #fff; text-align: right; white-space: nowrap; }
  @media (max-width: 480px) { dd { white-space: normal; } }
</style>
