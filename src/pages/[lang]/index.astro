---
// Homepage: one continuous film. Intro → library of episodes → the fall with the books → a walk through
// Carrie's house (wall of my life, desk papers, garden quiz, fireplace chat, front door), then episodes,
// e-mail and footer slide up over the night scene. With reduced motion the classic sections are shown instead.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Episodes from '../../components/Episodes.astro';
import PhotoWall from '../../components/PhotoWall.astro';
import WallStop from '../../components/WallStop.astro';
import DeskStop from '../../components/DeskStop.astro';
import GardenStop from '../../components/GardenStop.astro';
import FireStop from '../../components/FireStop.astro';
import DoorStop from '../../components/DoorStop.astro';
import Follow from '../../components/Follow.astro';
import Footer from '../../components/Footer.astro';
import Progress from '../../components/Progress.astro';
import Cards from '../../components/Cards.astro';
import RealCarrie from '../../components/RealCarrie.astro';
import Quiz from '../../components/Quiz.astro';
import { availableLocales, t, type Locale } from '../../i18n';
// the first screen's fonts, fetched with the stylesheet instead of after it: the logo (Cinzel 600/700), the first title
// (Montserrat) and the line above it (Manrope). Only the latin files every language uses; other subsets load as before.
import fMark6 from '@fontsource/cinzel/files/cinzel-latin-600-normal.woff2?url';
import fMark7 from '@fontsource/cinzel/files/cinzel-latin-700-normal.woff2?url';
import fHead from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import fBody from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
const FIRST_FONTS = [fHead, fBody, fMark7, fMark6];

export function getStaticPaths() {
  return availableLocales().map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
const s = t(locale);
---
<Base locale={locale} title={s.meta.title} description={s.meta.description}>
  {/* the first screen's picture (the film's poster) comes first; the film itself waits for the first title (Hero) */}
  <link slot="head" rel="preload" as="image" href="/assets/film/poster.jpg" fetchpriority="high" />
  {FIRST_FONTS.map((f) => <link slot="head" rel="preload" as="font" type="font/woff2" href={f} crossorigin />)}
  <Header locale={locale} />
  <main>
    <Hero locale={locale} house>
      <div class="after" slot="after">
        <div class="classic">
          <RealCarrie locale={locale} />
          <Cards locale={locale} />
          <Quiz locale={locale} />
        </div>
        <Follow locale={locale} />
        <Footer locale={locale} />
      </div>
    </Hero>
    <Episodes locale={locale} />
    <PhotoWall locale={locale} />
    <WallStop locale={locale} />
    <DeskStop locale={locale} />
    <GardenStop locale={locale} />
    <FireStop locale={locale} />
    <DoorStop locale={locale} />
  </main>
  <Progress locale={locale} />
  <script>
    // reduced motion: the classic sections carry the menu anchors (#carrie, #papers-game, #quiz), not the film's
    if (document.documentElement.classList.contains('nofilm')) document.querySelectorAll('.spacer .anchor').forEach((a) => a.removeAttribute('id'));
    else document.querySelectorAll('.classic [id]').forEach((el) => el.removeAttribute('id'));
  </script>
  <style>
    /* the last part of the page scrolls up over the night scene at the front door */
    .after { position: relative; z-index: 8; background: linear-gradient(180deg, rgba(13,12,10,0) 0, rgba(13,12,10,.82) 38vh, #0d0c0a 70vh); padding-top: 45vh; }
    .after :global(.follow) { background: none; }
    .classic { display: none; }
    :global(.nofilm) .classic { display: block; }
    :global(.nofilm) .after { padding-top: 0; background: var(--ink); }
  </style>
</Base>
