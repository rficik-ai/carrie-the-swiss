---
import '@fontsource/cinzel/600.css';
import '@fontsource/cinzel/700.css';
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '@fontsource-variable/manrope';
import '@fontsource-variable/montserrat';
import '../styles/global.css';
import Cursor from '../components/Cursor.astro';
import { availableLocales, HTML_LANG, type Locale } from '../i18n';

interface Props { locale: Locale; title: string; description: string; path?: string; noindex?: boolean }
const { locale, title, description, path = '', noindex = false } = Astro.props;
const site = Astro.site!.toString().replace(/\/$/, '');
const canonical = `${site}/${locale}/${path}`;
const ogImage = `${site}/assets/img/og.jpg`;
---
<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {availableLocales().map((l) => <link rel="alternate" hreflang={HTML_LANG[l]} href={`${site}/${l}/${path}`} />)}
    <link rel="alternate" hreflang="x-default" href={`${site}/`} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0d0c0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={HTML_LANG[locale]} />
    <!-- before the first paint: the hidden starting states of the text animations must never be reached by a transition -->
    <script is:inline>document.documentElement.classList.add('js'); if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('nofilm');</script>
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
    <Cursor />
  
<script>
  import { track, referrerHost } from '../lib/ev';
  import { startHeat } from '../lib/heat';
  startHeat();   // anonymous heat map: rough tap spots, scroll depth, time per scene (sent once when the page is left)
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;   // js / nofilm classes: inline script in <head>
  // reveal on scroll
  const rio = new IntersectionObserver((ents) => ents.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); rio.unobserve(e.target); } }), { threshold: 0.15 });
  document.querySelectorAll('[data-reveal]').forEach((el) => rio.observe(el));
  // floating gold dust: three depth layers, wandering paths, mixed speeds
  document.querySelectorAll<HTMLCanvasElement>('canvas.dust').forEach((cv) => {
    if (reduce) return;
    const ctx = cv.getContext('2d')!;
    let w = 0, h = 0, on = false, raf = 0, last = 0;
    const dpr = Math.min(2, devicePixelRatio || 1);
    const N = innerWidth < 700 ? 14 : 30;
    const R = Math.random;
    // near = big, soft, full speed · mid = 20 % slower · far = small, faint, 40 % slower
    const layers = [
      { share: .2, r: [2.4, 3.8], glow: 7, a: [.28, .5], speed: 1 },
      { share: .4, r: [1.1, 2.0], glow: 5, a: [.3, .6], speed: .8 },
      { share: .4, r: [.5, 1.0], glow: 4, a: [.18, .38], speed: .6 },
    ];
    const pick = () => { const x = R(); return x < layers[0].share ? layers[0] : x < layers[0].share + layers[1].share ? layers[1] : layers[2]; };
    const ps = Array.from({ length: N }, () => {
      const L = pick();
      return {
        x: R(), y: R(), L,
        r: L.r[0] + R() * (L.r[1] - L.r[0]),
        a: L.a[0] + R() * (L.a[1] - L.a[0]),
        v: (0.115 + R() * 0.335) * L.speed,         // share of the height per second
        f1: .15 + R() * .35, f2: .5 + R() * .9, p1: R() * 6.28, p2: R() * 6.28,
        A1: .5 + R() * .7, A2: .15 + R() * .35, tw: R() * 6.28, tf: 1 + R() * 2,
      };
    });
    const size = () => { w = cv.clientWidth; h = cv.clientHeight; cv.width = w * dpr; cv.height = h * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0); };
    const tick = (ms: number) => {
      const t = ms / 1000, dt = Math.min(.05, last ? t - last : .016); last = t;
      ctx.clearRect(0, 0, w, h);
      for (const p of ps) {
        const ang = Math.sin(t * p.f1 + p.p1) * p.A1 + Math.sin(t * p.f2 + p.p2) * p.A2; // wandering heading
        p.x += Math.sin(ang) * p.v * dt * (h / Math.max(w, 1));
        p.y -= Math.cos(ang) * p.v * dt;
        if (p.y < -0.03) { p.y = 1.03; p.x = R(); }
        if (p.x < -0.03) p.x = 1.03; else if (p.x > 1.03) p.x = -0.03;
        const x = p.x * w, y = p.y * h, rr = p.r * p.L.glow;
        const tw = .6 + .4 * Math.sin(t * p.tf + p.tw);
        const g = ctx.createRadialGradient(x, y, 0, x, y, rr);
        g.addColorStop(0, `rgba(255,232,170,${p.a * tw})`);
        g.addColorStop(.35, `rgba(255,214,140,${p.a * tw * .45})`);
        g.addColorStop(1, 'rgba(255,214,140,0)');
        ctx.fillStyle = g; ctx.beginPath(); ctx.arc(x, y, rr, 0, 6.283); ctx.fill();
      }
      if (on) raf = requestAnimationFrame(tick);
    };
    new ResizeObserver(size).observe(cv); size();
    new IntersectionObserver(([e]) => { on = e.isIntersecting; cancelAnimationFrame(raf); last = 0; if (on) raf = requestAnimationFrame(tick); }).observe(cv);
  });
  // measurement (no cookies): this visit, where it came from (?utm_source=… wins over the referrer), clicks out
  const qs = new URLSearchParams(location.search);
  const pageKey = location.pathname.replace(/^\/(en|sk|cs|de|pl|fr|it|es|uk|hu|nl)\//, '/').replace(/\/+$/, '') || '/';
  track('visit', pageKey === '/' ? 'home' : pageKey.slice(1).split('/')[0], true, (qs.get('utm_source') || qs.get('src') || referrerHost()).slice(0, 60));
  if (qs.has('subscribed')) track('signup', 'confirmed', true);
  // counted: tidy the address, so a shared link doesn't carry the tag on to the next visitor
  const tags = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'src'].filter((k) => qs.has(k));
  if (tags.length) { tags.forEach((k) => qs.delete(k)); const s = qs.toString(); history.replaceState(history.state, '', location.pathname + (s ? '?' + s : '') + location.hash); }
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
    if (!a || a.dataset.yt) return;   // a video played in the site's own player is counted there
    if (/youtube\.com|youtu\.be/.test(a.href)) track('out', 'yt'); else if (/instagram\.com/.test(a.href)) track('out', 'ig');
  });
  // links that open a specific book on the shelf
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-open-book]');
    if (!a || !document.getElementById('episodes')) return;
    e.preventDefault();
    document.getElementById('episodes')!.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
    window.dispatchEvent(new CustomEvent('open-book', { detail: a.dataset.openBook }));
  });
</script>
</body>
</html>
