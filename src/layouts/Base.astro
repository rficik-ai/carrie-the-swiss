---
import '@fontsource/cinzel/600.css';
import '@fontsource/cinzel/700.css';
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { availableLocales, HTML_LANG, type Locale } from '../i18n';

interface Props { locale: Locale; title: string; description: string; }
const { locale, title, description } = Astro.props;
const site = Astro.site!.toString().replace(/\/$/, '');
const canonical = `${site}/${locale}/`;
const ogImage = `${site}/assets/img/og.jpg`;
---
<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {availableLocales().map((l) => <link rel="alternate" hreflang={HTML_LANG[l]} href={`${site}/${l}/`} />)}
    <link rel="alternate" hreflang="x-default" href={`${site}/`} />
    <meta name="theme-color" content="#0d0c0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={HTML_LANG[locale]} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
