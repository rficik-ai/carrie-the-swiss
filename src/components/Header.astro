---
import Music from './Music.astro';
import { availableLocales, LOCALE_LABELS, type Locale, t } from '../i18n';
interface Props { locale: Locale; page?: string }
const { locale, page = '' } = Astro.props;
const home = `/${locale}/`;
const s = t(locale);
---
<header class="top" id="top">
  <div class="wrap bar">
    <a class="mark" href={`/${locale}/`} aria-label="Carrie the Swiss">
      <span class="crest" aria-hidden="true">
        <img src="/assets/img/crest.png" alt="" width="40" height="48" onerror="this.parentElement.remove()" />
      </span>
      <span class="words"><b>CARRIE</b><small>THE SWISS</small></span>
    </a>
    <nav class="links" aria-label="Main">
      <a href={`${home}#episodes`}>{s.nav.episodes}</a>
      <a href={`${home}#carrie`}>{s.nav.carrie}</a>
      <a href={`${home}papers/`} aria-current={page === 'papers/' ? 'page' : undefined}>{(s.nav as any).papers ?? s.nav.guide}</a>
      <a href={`${home}#ask`}>{(s.nav as any).ask ?? 'Ask Carrie'}</a>
      <a href={`${home}#night`}>{s.nav.shop}</a>
    </nav>
    <div class="tools">
    <a class="game" href="/herna/" aria-label={(s.nav as any).game ?? 'Game'}>
      <span class="gic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7.5 7h9a5 5 0 0 1 4.9 6l-.8 3.6a2.4 2.4 0 0 1-4.1 1.1L14.2 15H9.8l-2.3 2.7a2.4 2.4 0 0 1-4.1-1.1L2.6 13A5 5 0 0 1 7.5 7zm0 3v1.5H6v1.5h1.5v1.5H9V13h1.5v-1.5H9V10zm8.25.25a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2zm2 2.2a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2z"/></svg></span>
      <span class="glb">{(s.nav as any).game ?? 'Game'}</span>
    </a>
    <Music locale={locale} />
    <details class="lang">
      <summary aria-label={s.nav.language}>{locale.toUpperCase()}<span aria-hidden="true">▾</span></summary>
      <ul>
        {availableLocales().map((l) => (
          <li><a href={`/${l}/${page}`} hreflang={l} aria-current={l === locale ? 'page' : undefined}>{LOCALE_LABELS[l]}</a></li>
        ))}
      </ul>
    </details>
    </div>
  </div>
</header>

<style>
  .top {
    position: fixed; inset: 0 0 auto; z-index: 50;
    padding-top: env(safe-area-inset-top, 0px);
    background: linear-gradient(180deg, rgba(13,12,10,.72), rgba(13,12,10,0));
    transition: background .3s;
  }
  :global(body.scrolled) .top { background: rgba(13,12,10,.86); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  /* standing inside a scene of the film: the menu floats over the picture */
  :global(body.in-scene) .top { background: linear-gradient(180deg, rgba(13,12,10,.62), rgba(13,12,10,0)); backdrop-filter: none; -webkit-backdrop-filter: none; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-block: 14px; }
  .mark { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .crest img { width: 34px; height: auto; }
  .words { display: flex; flex-direction: column; align-items: center; line-height: 1; }
  .words b {
    font-family: var(--f-mark); font-weight: 700; font-size: 20px; letter-spacing: .16em;
    background: var(--grad-gold); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .words small { font-family: var(--f-mark); font-size: 8.5px; letter-spacing: .38em; color: var(--gold); margin-top: 5px; padding-left: .38em; }
  .links { display: none; gap: 30px; font-size: 14px; font-weight: 500; }
  .links a { text-decoration: none; color: var(--muted-dark); transition: color .2s; }
  .links a:hover { color: var(--ivory); }
  @media (min-width: 860px) { .links { display: flex; } }

  .tools { display: flex; align-items: center; gap: 10px; }
  .game { height: 40px; box-sizing: border-box; padding: 0 14px 0 6px; border-radius: 999px; display: flex; align-items: center; gap: 8px; text-decoration: none;
    border: 1px solid rgba(234,211,154,.45); font: 700 12px var(--f-body); letter-spacing: .12em; text-transform: uppercase; color: var(--ivory); transition: border-color .2s, background .2s; }
  .game:hover { border-color: var(--gold); background: rgba(234,211,154,.08); }
  .gic { width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: var(--grad-gold, var(--gold)); }
  .gic svg { width: 17px; height: 17px; fill: #1a1408; }
  @media (max-width: 560px) { .glb { display: none; } .game { padding: 0 5px; } }
  .lang { position: relative; }
  .lang summary {
    list-style: none; cursor: pointer; display: flex; align-items: center; gap: 6px;
    font-size: 12px; font-weight: 700; letter-spacing: .12em;
    border: 1px solid rgba(234,211,154,.35); border-radius: 999px; padding: 8px 14px; min-height: 40px;
  }
  .lang summary::-webkit-details-marker { display: none; }
  .lang span { font-size: 10px; opacity: .7; }
  .lang ul {
    position: absolute; right: 0; top: calc(100% + 8px); margin: 0; padding: 8px; list-style: none;
    background: var(--ink-2); border: 1px solid var(--ink-line); border-radius: 12px; min-width: 190px;
    box-shadow: 0 20px 40px -10px rgba(0,0,0,.6);
    max-height: 70vh; overflow: auto;
  }
  .lang li a { display: block; padding: 9px 12px; border-radius: 8px; text-decoration: none; font-size: 15px; }
  .lang li a:hover { background: rgba(234,211,154,.08); }
  .lang li a[aria-current='page'] { color: var(--gold-hi); }
</style>

<script>
  const onScroll = () => document.body.classList.toggle('scrolled', window.scrollY > 40);
  addEventListener('scroll', onScroll, { passive: true }); onScroll();
  document.addEventListener('click', (e) => {
    document.querySelectorAll('details.lang[open], details.music[open]').forEach((d) => { if (!d.contains(e.target as Node)) d.removeAttribute('open'); });
  });
</script>
