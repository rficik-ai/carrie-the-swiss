---
import { type Locale, t } from '../i18n';
import ChatPanel from './ChatPanel.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const a = (t(locale) as any).ask;
const chips = [a.c1, a.c2, a.c3, a.c4].filter(Boolean);
---
<section class="block ask" id="ask">
  <canvas class="dust" aria-hidden="true"></canvas>
  <div class="wrap grid">
    <div class="intro" data-reveal>
      <div class="avatar"><img src="/assets/img/twin-head.jpg" alt="" loading="lazy" /></div>
      <p class="eyebrow">{a.eyebrow}</p>
      <h2>{a.title}</h2>
      <p class="muted">{a.intro}</p>
      <p class="note">{a.note}</p>
    </div>
    <ChatPanel locale={locale} />
  </div>
</section>

<style>
  .ask { position: relative; overflow: hidden; background: radial-gradient(60% 50% at 80% 0%, rgba(201,163,91,.14), transparent 70%), var(--ink); }
  .ask > .wrap { position: relative; z-index: 2; }
  .grid { display: grid; gap: clamp(32px, 5vw, 72px); align-items: center; }
  @media (min-width: 960px) { .grid { grid-template-columns: .8fr 1.2fr; } }
  .intro { display: grid; gap: 16px; justify-items: start; }
  .avatar { width: 112px; height: 112px; border-radius: 50%; overflow: hidden; box-shadow: 0 0 0 2px var(--gold), 0 0 0 8px rgba(201,163,91,.15), 0 20px 40px -20px rgba(0,0,0,.8); }
  .avatar img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  .intro h2 { font-size: clamp(36px, 5vw, 64px); }
  .note { margin: 0; font-size: 13px; color: var(--muted-dark); max-width: 30em; }
</style>
