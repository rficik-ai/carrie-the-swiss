---
// Desktop stop at the end of film 2: the floating photos become interactive.
// Real photos flip to their animated twin. Everything sits on the frozen film frame (nothing is swapped).
import { type Locale, t } from '../i18n';
import { PHOTOS } from '../data/photos';
import { pic } from '../lib/pic';
import TapIcon from './TapIcon.astro';
import Split from './Split.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const r = t(locale).real as Record<string, string>;
const cur = (t(locale) as any).cursor;
---
<div class="pwall" aria-label={r.title}>
  <div class="pf">
    {/* the backs show only when a photo turns over, long after the first screen: they load once the first title is
        on screen (data-late-*, see Hero), at low priority */}
    {PHOTOS.map((ph) => { const b = pic(ph.back, 'f'); return (
      <button type="button" class="pcard" aria-label={r.anim_caption} data-cur={cur.flip} style={`width:${ph.w}px;height:${ph.h}px;transform:${ph.css}`} data-h={JSON.stringify(ph.H)} data-w={ph.w} data-hh={ph.h}>
        <span class="flip">
          <canvas class="front" width={ph.w} height={ph.h}></canvas>
          <span class="back"><picture style="display:contents">{b.avif && <source type="image/avif" data-late-srcset={b.avif} />}{b.webp && <source type="image/webp" data-late-srcset={b.webp} />}<img data-late-src={b.src} alt="" loading="lazy" decoding="async" fetchpriority="low" /></picture></span>
        </span>
      </button>
    ); })}
  </div>
  <div class="ptext center rv">
    <p class="eyebrow kicker rf"><span class="no">03</span>{r.eyebrow}</p>
    <h2 class="fx-flip" aria-label={r.title}><Split text={r.title} by="word" /></h2>
    <p class="say rf">{r.text}</p>
    <p class="hint tapchip rf" style="--fd:.65s"><TapIcon /><span class="h-wide">{r.hover}</span><span class="h-tap">{r.tap}</span></p>
    <a class="pill-cta rf" style="--fd:.8s" href={`/${locale}/papers/`}>{r.cta ?? 'See my papers'} <span aria-hidden="true">→</span></a>
  </div>
</div>

<style>
  .pwall { display: none; }
  :global(.js:not(.nofilm)) .pwall { display: block; }
  .pwall { position: absolute; inset: 0; z-index: 4; opacity: 0; pointer-events: none; transition: opacity .35s ease; }
    .pwall.live { opacity: 1; pointer-events: auto; }
    .pf { position: absolute; left: 0; top: 0; width: 1920px; height: 1080px; transform-origin: 0 0; }
    .pcard { all: unset; position: absolute; left: 0; top: 0; transform-origin: 0 0; transform-style: preserve-3d; perspective: 1000px; cursor: pointer; }
    .flip { position: absolute; inset: 0; transform-style: preserve-3d; opacity: 0;
      transition: transform .85s cubic-bezier(.2,.7,.2,1), opacity 0s .85s; }
    .pcard.flipped .flip, .pcard:focus-visible .flip { opacity: 1; transform: translateZ(14px) rotateY(180deg); transition: transform .85s cubic-bezier(.2,.7,.2,1), opacity 0s 0s; }
    .front, .back { position: absolute; inset: 0; width: 100%; height: 100%; backface-visibility: hidden; -webkit-backface-visibility: hidden; display: block; }
    .back { transform: rotateY(180deg); padding: 3.5%; background: #f6efe0; box-shadow: 0 20px 40px -12px rgba(0,0,0,.6); box-sizing: border-box; }
    .back img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .ptext { position: absolute; left: 0; right: 0; bottom: 0; padding: 120px 24px 44px; display: grid; justify-items: center; gap: 10px; text-align: center; --ko: center;
      background: linear-gradient(0deg, rgba(13,9,4,.9) 0%, rgba(13,9,4,.65) 50%, rgba(13,9,4,0) 100%); pointer-events: none;
      opacity: 0; transform: translateY(12px); transition: opacity .8s ease .3s, transform .8s ease .3s; }
    .pwall.live .ptext { opacity: 1; transform: none; }
    .ptext h2 { font-size: clamp(34px, 4.2vw, 60px); color: #fff; text-shadow: 0 2px 24px rgba(0,0,0,.35); }
    .ptext .say { margin: 0; max-width: 40em; font: 500 clamp(16px, 1.25vw, 19px)/1.5 var(--f-body); color: rgba(244,238,226,.88); }
    .ptext .hint { margin: 4px 0 8px; }
    .pwall.live .ptext .pill-cta { pointer-events: auto; }   /* only while the wall shows: hidden, it sat over the shelf's "Open the book" */
  .h-tap { display: none; }
  @media (hover: hover) and (min-width: 900px) { .pcard:hover .flip { opacity: 1; transform: translateZ(14px) rotateY(180deg); transition: transform .85s cubic-bezier(.2,.7,.2,1), opacity 0s 0s; } }
  @media (max-width: 899px), (hover: none) {
    .h-wide { display: none; } .h-tap { display: inline; }
    .ptext { padding: 48px 18px calc(18px + env(safe-area-inset-bottom, 0px)); gap: 7px; }
    .ptext .kicker::before { margin-bottom: 9px; }
    .ptext h2 { font-size: 28px; }
    .ptext .say { font-size: 14.5px; line-height: 1.45; }
    .ptext .hint { margin: 2px 0 4px; padding: 8px 13px; }
  }
</style>

<script>
  import { track } from '../lib/ev';
  import { wallFrame, drift, isWide } from '../lib/frame';
  const wide = isWide();
  const wall = document.querySelector<HTMLElement>('.pwall');
  if (wall && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const stage = document.querySelector<HTMLElement>('.scrub .stage')!;
    stage.appendChild(wall); // lives on the frozen film frame
    const pf = wall.querySelector<HTMLElement>('.pf')!;
    const W_ = window as any;
    let lastKey = '';
    // phones see all three photos at once (wallFrame): nothing to drag sideways
    const fit = () => {
      const c = drift(wallFrame(stage.clientWidth, stage.clientHeight), W_.__drift ?? 1);
      pf.style.transform = `translate(${c.left}px, ${c.top}px) scale(${c.k})`;
    };
    // desktop flips a photo on hover: count each one once
    if (wide) wall.querySelectorAll<HTMLElement>('.pcard').forEach((card, i) => card.addEventListener('mouseenter', () => track('flip', String(i + 1), true)));
    wall.querySelectorAll<HTMLElement>('.pcard').forEach((card) => card.addEventListener('click', () => {
      if (wide) return;
      const was = card.classList.contains('flipped');
      wall.querySelectorAll('.pcard').forEach((c) => c.classList.remove('flipped'));
      if (!was) { card.classList.add('flipped'); track('flip', String([...wall.querySelectorAll('.pcard')].indexOf(card) + 1), true); }
    }));
    // front faces: the photo exactly as it appears in the film, unwarped into the card rectangle
    const paint = (url: string) => {
      const img = new Image();
      img.onload = () => {
        const cv = document.createElement('canvas'); cv.width = 1920; cv.height = 1080;
        const cx = cv.getContext('2d')!; cx.drawImage(img, 0, 0);
        const src = cx.getImageData(0, 0, 1920, 1080).data;
        wall.querySelectorAll<HTMLElement>('.pcard').forEach((card) => {
          const [a, b, c, d, e, f, g, h] = JSON.parse(card.dataset.h!);
          const w = Number(card.dataset.w), hh = Number(card.dataset.hh);
          const out = card.querySelector('canvas')!.getContext('2d')!;
          const id = out.createImageData(w, hh); const o = id.data;
          for (let v = 0; v < hh; v++) for (let u = 0; u < w; u++) {
            const z = g * (u + .5) + h * (v + .5) + 1;
            const x = (a * (u + .5) + b * (v + .5) + c) / z - .5, y = (d * (u + .5) + e * (v + .5) + f) / z - .5;
            const x0 = Math.max(0, Math.min(1918, Math.floor(x))), y0 = Math.max(0, Math.min(1078, Math.floor(y)));
            const fx = Math.min(1, Math.max(0, x - x0)), fy = Math.min(1, Math.max(0, y - y0));
            const i00 = (y0 * 1920 + x0) * 4, i10 = i00 + 4, i01 = i00 + 1920 * 4, i11 = i01 + 4, k = (v * w + u) * 4;
            for (let ch = 0; ch < 3; ch++) {
              o[k + ch] = (src[i00 + ch] * (1 - fx) + src[i10 + ch] * fx) * (1 - fy) + (src[i01 + ch] * (1 - fx) + src[i11 + ch] * fx) * fy;
            }
            o[k + 3] = 255;
          }
          out.putImageData(id, 0, 0);
        });
      };
      img.src = url;
    };
    if (W_.__photosFrame) paint(W_.__photosFrame);
    window.addEventListener('photos-frame', (e) => paint((e as CustomEvent).detail));
    const watch = () => {
      const key = `${stage.clientWidth}x${stage.clientHeight}x${W_.__drift ?? 1}`;
      if (key !== lastKey) { lastKey = key; fit(); }
      const p = W_.__filmP ?? 0, live = wall.classList.contains('live');
      const on = live ? p > 0.83 && p < 0.985 : p >= 0.84 && p < 0.97 && W_.__film2AtEnd !== false && W_.__film2Q >= 0.999;
      if (on !== live) { wall.classList.toggle('live', on); wall.inert = !on; wall.querySelector('.ptext')!.classList.toggle('rv-in', on); }
      requestAnimationFrame(watch);
    };
    wall.inert = true;   // hidden, the wall can't be tapped or tabbed into (it lies over the shelf)
    requestAnimationFrame(watch);
  }
</script>
