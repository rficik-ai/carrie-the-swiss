---
import { type Locale, t } from '../i18n';
import { HOUSE } from '../data/house';
interface Props { locale: Locale; house?: boolean }
const { locale, house = false } = Astro.props;
const s = t(locale);
const chapters = [
  { title: s.hero.ch1_title, text: s.hero.ch1_text, eyebrow: s.hero.eyebrow },
  { title: s.hero.ch2_title, text: s.hero.ch2_text },
  { title: s.hero.ch3_title, text: s.hero.ch3_text, cta: true },
];
---
<section class:list={['scrub', { 'with-house': house }]} id="film" aria-label="Carrie" data-split="0.6" data-house={house ? JSON.stringify(HOUSE.timeline) : undefined}>
  <div class="stage">
    <div class="fill" aria-hidden="true"></div>
    <video
      class="film"
      muted playsinline preload="auto" disablepictureinpicture
      poster="/assets/film/poster.jpg"
      data-src-desktop="/assets/film/film-v3.mp4"
      data-src-mobile="/assets/film/film-m-v4.mp4"
      aria-hidden="true"
    ></video>
    <video class="film film2" muted playsinline preload="none" disablepictureinpicture data-src="/assets/film/film2-v1.mp4" data-src-mobile="/assets/film/film2-m-v1.mp4" aria-hidden="true"></video>
    <div class="shade" aria-hidden="true"></div>
    <canvas class="dust" aria-hidden="true"></canvas>
    <div class="toPaper" aria-hidden="true"></div>
    <div class="chapters wrap">
      {chapters.map((c, i) => (
        <article class="chapter" data-i={i}>
          {c.eyebrow && <p class="eyebrow">{c.eyebrow}</p>}
          <h1 class={i === 0 ? 'big' : ''}>{c.title}</h1>
          <p class="lead">{c.text}</p>
          {c.cta && <a class="pill-cta" href="#episodes">{s.hero.cta} <span aria-hidden="true">→</span></a>}
        </article>
      ))}
    </div>
    {house && (
      <div class="house" aria-hidden="true">
        <div class="hfill"></div>
        {HOUSE.stops.map((h) => <img class="still" data-stop={h.id} data-src={h.img} alt="" width="1920" height="1080" decoding="async" />)}
      </div>
    )}
    <slot />
    <div class="toInk" aria-hidden="true"></div>
    <div class="progress" aria-hidden="true"><span></span></div>
    <p class="hint" aria-hidden="true">{s.hero.scroll}<i></i></p>
  </div>
  {house && <div class="spacer" aria-hidden="true">{HOUSE.anchors.map((a) => <span class="anchor" id={a.id} data-at={a.at}></span>)}</div>}
  <slot name="after" />
</section>

<style>
  .scrub { position: relative; height: 680vh; background: var(--ink); }
  .scrub { height: 1100vh; }
  .film2 { opacity: 0; }
  .scrub.with-house { height: auto; }
  .spacer { position: relative; height: 1000vh; pointer-events: none; }
  .anchor { position: absolute; left: 0; width: 1px; height: 1px; }
  .house { position: absolute; inset: 0; z-index: 5; pointer-events: none; }
  .hfill { position: absolute; inset: -40px; background: #0d0c0a center / cover; filter: blur(26px) brightness(.45) saturate(1.1); opacity: 0; transition: opacity .3s; }
  .still { position: absolute; left: 0; top: 0; width: 1920px; height: 1080px; max-width: none; transform-origin: 0 0; opacity: 0; will-change: transform, opacity; }
  .toInk { position: absolute; inset: 0; z-index: 6; pointer-events: none; opacity: 0; background: var(--ink); }
  .stage { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }
  .fill { position: absolute; inset: -40px; background: url(/assets/img/shelf-scene-v2.jpg) center / cover; filter: blur(26px) brightness(.42) saturate(1.1); opacity: 0; }
  .film { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform-origin: 0 0; will-change: transform; background: radial-gradient(120% 80% at 70% 60%, #2a2418 0%, #0d0c0a 70%); }
  .shade { position: absolute; inset: 0; background:
    linear-gradient(90deg, rgba(13,12,10,.78) 0%, rgba(13,12,10,.35) 45%, rgba(13,12,10,0) 70%),
    linear-gradient(0deg, rgba(13,12,10,.85) 0%, rgba(13,12,10,0) 40%); }
  .toPaper { position: absolute; inset: 0; z-index: 1; pointer-events: none; opacity: 0; background: linear-gradient(180deg, rgba(251,248,241,0) 55%, var(--paper) 100%); }
  .chapters { position: absolute; z-index: 2; inset: 0; display: grid; align-items: end; padding-bottom: max(13vh, 96px); }
  .chapter {
    grid-area: 1 / 1; max-width: 640px; display: grid; gap: 18px; justify-items: start;
    opacity: 0; transform: translateY(24px); transition: opacity .6s ease, transform .6s ease; pointer-events: none;
  }
  .chapter.on { opacity: 1; transform: none; pointer-events: auto; }
  .chapter h1 { font-size: clamp(38px, 6vw, 80px); color: var(--ivory); }
  .chapter h1.big { font-size: clamp(48px, 8.5vw, 112px); }
  .lead { font-size: clamp(17px, 1.5vw, 20px); color: rgba(244,238,226,.82); max-width: 32em; }
  .progress { position: absolute; left: var(--gutter); right: var(--gutter-r); bottom: calc(28px + env(safe-area-inset-bottom, 0px)); height: 1px; background: rgba(234,211,154,.18); }
  .progress span { display: block; height: 100%; width: 0; background: var(--gold); }
  .hint { position: absolute; right: var(--gutter-r); bottom: calc(44px + env(safe-area-inset-bottom, 0px)); font-size: 11px; letter-spacing: .24em; text-transform: uppercase; color: var(--muted-dark); display: flex; align-items: center; gap: 10px; transition: opacity .4s; }
  .hint i { width: 1px; height: 28px; background: linear-gradient(var(--gold), transparent); animation: drip 1.8s ease-in-out infinite; }
  @keyframes drip { 0% { transform: scaleY(0); transform-origin: top } 50% { transform: scaleY(1); transform-origin: top } 51% { transform-origin: bottom } 100% { transform: scaleY(0); transform-origin: bottom } }
  @media (max-width: 700px) {
    .shade { background: linear-gradient(0deg, rgba(13,12,10,.92) 0%, rgba(13,12,10,.4) 50%, rgba(13,12,10,.1) 75%); }
    .chapters { padding-bottom: max(11vh, 84px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .scrub { height: auto; }
    .stage { position: relative; height: auto; min-height: 100svh; }
    .chapters { position: relative; gap: 56px; padding-block: 30vh 80px; }
    .chapter { grid-area: auto; opacity: 1; transform: none; pointer-events: auto; }
    .progress, .hint { display: none; }
  }
</style>

<script>
  import { coverFrame, fitFrame, wallFrame, lerpFrame, stopFrame, type Frame } from '../lib/frame';
  import { STOPS, type Step } from '../data/house';
  const section = document.querySelector<HTMLElement>('.scrub')!;
  const stage = section.querySelector<HTMLElement>('.stage')!;
  const video = section.querySelector<HTMLVideoElement>('.film:not(.film2)')!;
  const video2 = section.querySelector<HTMLVideoElement>('.film2')!;
  const chapters = [...section.querySelectorAll<HTMLElement>('.chapter')];
  const bar = section.querySelector<HTMLElement>('.progress span')!;
  const hint = section.querySelector<HTMLElement>('.hint')!;
  const shade = section.querySelector<HTMLElement>('.shade')!;
  const toPaper = section.querySelector<HTMLElement>('.toPaper')!;
  const toInk = section.querySelector<HTMLElement>('.toInk')!;
  const fill = section.querySelector<HTMLElement>('.fill')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const split = Number(section.dataset.split || 1); // share of film 1 that carries the text chapters
  const wide = matchMedia('(min-width: 900px) and (hover: hover)').matches;

  // Desktop timeline (share of the whole scroll):
  //  film 1 (intro + dive into the eye)  0 → A1 · shelf stop A1 → H1 · film 2 (fall with the books) H1 → B1
  //  photo-wall stop B1 → H2 · dissolve into the dark next section H2 → 1
  const A1 = reduce ? 1 : 0.5, H1 = 0.6, B1 = 0.84, H2 = 0.94;
  const clamp = (x: number) => Math.min(1, Math.max(0, x));
  const smooth = (x: number) => { x = clamp(x); return x * x * (3 - 2 * x); };
  let cur1 = 0, cur2 = 0, ready1 = false, ready2 = false, loading2 = false;
  const W_ = window as any;

  // ---- the walk through the house (beta page): continues after the photo wall
  const HT = section.dataset.house ? JSON.parse(section.dataset.house) as { steps: Step[]; total: number; start: number } : null;
  const spacer = section.querySelector<HTMLElement>('.spacer');
  const stills = new Map([...section.querySelectorAll<HTMLImageElement>('.house .still')].map((im) => [im.dataset.stop!, im]));
  const houseEl = section.querySelector<HTMLElement>('.house');
  const hfill = section.querySelector<HTMLElement>('.house .hfill');
  function sizeSpacer() {
    if (!HT || !spacer) return;
    const vh = stage.clientHeight / 100;
    spacer.style.height = `${(HT.start * 1000 + HT.total) * vh}px`;
    spacer.querySelectorAll<HTMLElement>('.anchor').forEach((a) => { a.style.top = `${(HT.start * 1000 + Number(a.dataset.at)) * vh}px`; });
  }
  sizeSpacer(); addEventListener('resize', sizeSpacer);

  function progress() {
    const r = section.getBoundingClientRect();
    if (HT) return clamp(-r.top / (10 * stage.clientHeight));   // the old film keeps its 1000vh of scroll
    return clamp(-r.top / (section.offsetHeight - innerHeight));
  }
  const houseY = () => -section.getBoundingClientRect().top / stage.clientHeight * 100 - (HT ? HT.start * 1000 : 0);

  function place(im: HTMLImageElement, f: Frame, op: number) {
    if (op > 0 && !im.src) im.src = im.dataset.src!;
    im.style.opacity = String(op);
    im.style.transform = `translate(${f.left}px, ${f.top}px) scale(${f.k})`;
  }
  const frameOf = (id: string) => { const [W, H] = dims(); return stopFrame(STOPS.find((s) => s.id === id)!, W, H, undefined, (W_.__pan?.[id]) ?? 0); };
  const zoom = (f: Frame, z: number, W: number, H: number): Frame => ({ k: f.k * z, left: W / 2 - (W / 2 - f.left) * z, top: H / 2 - (H / 2 - f.top) * z });
  function renderHouse() {
    if (!HT || !houseEl) return;
    const y = houseY();
    const [W, H] = dims();
    // preload the stills of the next stops a little ahead
    let step = HT.steps.find((s) => y >= s.from && y < s.from + s.len) ?? (y >= HT.total ? HT.steps[HT.steps.length - 1] : null);
    if (y < 0 || !step) { houseEl.style.opacity = '0'; W_.__stop = null; document.body.classList.remove('in-scene'); if (y > -150) { const f = stills.get(STOPS[0].id); if (f && !f.src) f.src = f.dataset.src!; } return; }
    houseEl.style.opacity = '1';
    const i = STOPS.findIndex((s) => s.id === step!.stop);
    [i, i + 1].forEach((j) => { const n = STOPS[j] && stills.get(STOPS[j].id); if (n && !n.src) n.src = n.dataset.src!; });
    const t = clamp((y - step.from) / step.len);
    const cur = stills.get(step.stop)!, f = frameOf(step.stop);
    stills.forEach((im, id) => { if (id !== step!.stop && (i === 0 || id !== STOPS[i - 1].id)) im.style.opacity = '0'; });
    const needFill = f.k < coverFrame(W, H).k - 1e-3 || 1080 * f.k < H - 1;
    if (step.kind === 'move') {
      // stills phase: a slow push into the next room (replaced by the generated video later)
      const x = smooth(t);
      if (i > 0) { const pid = STOPS[i - 1].id; place(stills.get(pid)!, zoom(frameOf(pid), 1 + 0.12 * x, W, H), 1); }
      place(cur, zoom(f, 1.08 - 0.08 * x, W, H), x);
      W_.__stop = null;
      if (hfill) hfill.style.opacity = '0';
    } else {
      if (i > 0) stills.get(STOPS[i - 1].id)!.style.opacity = '0';
      place(cur, f, 1);
      W_.__stop = step.stop; W_.__stopT = t;
      if (hfill) {
        if (needFill && hfill.dataset.img !== step.stop) { hfill.dataset.img = step.stop; hfill.style.backgroundImage = `url(${cur.dataset.src})`; }
        hfill.style.opacity = needFill ? '1' : '0';
      }
    }
    W_.__houseY = y;
    document.body.classList.toggle('in-scene', step.kind === 'hold');
  }

  // place a 1920x1080 film box: e = 0 cover … 1 framing that fits the shelf below the menu
  // corr (0..1) undoes the small scale/offset between film 2's first frame and film 1's last frame
  const C2 = { s: 1 / 0.9866, x: 3.5728 / 0.9866, y: 4.8793 / 0.9866 };
  function frameVideo(v: HTMLVideoElement, target: Frame | null, corr = 0) {
    const W = stage.clientWidth, H = stage.clientHeight; // same box as the overlays (excludes the scrollbar)
    const c = coverFrame(W, H), f = target ?? c;
    const sc = 1 + (C2.s - 1) * corr, k = f.k * sc, r = k / c.k;
    const L = f.left + f.k * C2.x * corr, T = f.top + f.k * C2.y * corr;
    v.style.cssText += `;object-fit:fill;max-width:none;max-height:none;inset:auto;left:${c.left}px;top:${c.top}px;width:${1920 * c.k}px;height:${1080 * c.k}px`;
    v.style.transform = (L !== c.left || T !== c.top || r !== 1) ? `translate(${L - c.left}px, ${T - c.top}px) scale(${r})` : '';
  }
  const dims = () => [stage.clientWidth, stage.clientHeight] as const;
  const shelfF = () => { const [W, H] = dims(); return fitFrame(W, H, undefined, W_.__panS ?? 0); };
  const wallF = () => { const [W, H] = dims(); return wallFrame(W, H, undefined, W_.__panW ?? 0); };

  function seek(v: HTMLVideoElement, cur: number, target: number) {
    cur += (target - cur) * 0.18;
    if (Math.abs(target - cur) < 0.002) cur = target;
    if (!v.seeking && Math.abs(v.currentTime - cur) > 0.01) v.currentTime = cur;
    return cur;
  }

  function render(p: number) {
    const q1 = clamp(p / A1);
    const pc = q1 / split;
    const idx = pc > 1.02 ? -1 : Math.min(chapters.length - 1, Math.floor(Math.min(1, pc) * chapters.length * 0.999));
    chapters.forEach((c, i) => c.classList.toggle('on', reduce || i === idx));
    shade.style.opacity = String(1 - clamp((q1 - split) / 0.06));
    bar.style.width = `${q1 * 100}%`;
    bar.parentElement!.style.opacity = q1 > 0.97 ? '0' : '1';
    hint.style.opacity = p > 0.02 ? '0' : '1';
    W_.__filmQ = q1;
    if (reduce) return { q1, q2: 0 };

    // film 1: camera pulls back at the end so the whole shelf sits below the menu
    const e1 = smooth((q1 - 0.88) / 0.08);
    const q2 = clamp((p - H1) / (B1 - H1));
    // the painted Carrie slowly fades from the spines while the real one jumps up: she leaves the painting
    const x = ready2 ? smooth(q2 / 0.1) : 0;
    const [W, H] = dims(), cov = coverFrame(W, H);
    if (x < 1) frameVideo(video, lerpFrame(cov, shelfF(), e1));
    if (ready2) {
      // film 2 starts in the shelf framing, eases back to full screen, and on phones pulls back again for the photo wall
      const eS = 1 - smooth((q2 - 0.1) / 0.3), eW = wide ? 0 : smooth((q2 - 0.86) / 0.14);
      frameVideo(video2, lerpFrame(lerpFrame(cov, shelfF(), eS), wallF(), eW), eS);
      if (!wide && eW > 0 && W_.__photosFrame && fill.dataset.img !== 'photos') { fill.dataset.img = 'photos'; fill.style.backgroundImage = `url(${W_.__photosFrame})`; }
    }
    video.style.opacity = String(1 - x);
    video2.style.opacity = String(x);
    fill.style.opacity = String(x < 1 ? e1 : Math.max(1 - smooth((q2 - 0.1) / 0.3), wide ? 0 : smooth((q2 - 0.86) / 0.14)));
    toInk.style.opacity = HT ? '0' : String(smooth((p - H2) / 0.06));
    W_.__filmP = p; W_.__film2Q = q2;
    if (p > 0.25 && !loading2) loadFilm2();
    return { q1, q2 };
  }

  async function blobSrc(url: string) {
    try { const r = await fetch(url); if (!r.ok) throw 0; return URL.createObjectURL(await r.blob()); } catch { return url; }
  }

  async function load() {
    video.src = await blobSrc(wide ? video.dataset.srcDesktop! : video.dataset.srcMobile!);
    video.addEventListener('loadedmetadata', () => { ready1 = true; }, { once: true });
    video.load();
    snapshot(video.src, 'shelf-frame', '__shelfFrame');
  }

  async function loadFilm2() {
    loading2 = true;
    video2.src = await blobSrc(wide ? video2.dataset.src! : video2.dataset.srcMobile!);
    video2.addEventListener('loadedmetadata', () => { ready2 = true; }, { once: true });
    video2.load();
    snapshot(video2.src, 'photos-frame', '__photosFrame');
  }

  // Render a film's final frame through the same video decoder, so overlays cut from it match the film exactly.
  function snapshot(src: string, evt: string, key: string) {
    const v = document.createElement('video');
    v.muted = true; v.playsInline = true; v.preload = 'auto'; v.src = src;
    v.addEventListener('loadedmetadata', () => { v.currentTime = Math.max(0, v.duration - 0.05); }, { once: true });
    v.addEventListener('seeked', () => {
      const c = document.createElement('canvas'); c.width = 1920; c.height = 1080;
      c.getContext('2d')!.drawImage(v, 0, 0, 1920, 1080);
      c.toBlob((b) => {
        if (!b) return;
        const url = URL.createObjectURL(b);
        W_[key] = url;
        window.dispatchEvent(new CustomEvent(evt, { detail: url }));
        v.removeAttribute('src'); v.load();
      }, 'image/png');
    }, { once: true });
  }

  function tick() {
    const p = progress();
    const { q1, q2 } = render(p);
    renderHouse();
    // focusing something inside a scene must never scroll the clipped stage sideways
    if (stage.scrollLeft || stage.scrollTop) { stage.scrollLeft = 0; stage.scrollTop = 0; }
    if (ready1 && video.duration) {
      cur1 = seek(video, cur1, q1 * (video.duration - 0.05));
      W_.__filmAtEnd = q1 >= 0.999 && !video.seeking && Math.abs(video.currentTime - (video.duration - 0.05)) < 0.02;
    }
    if (ready2 && video2.duration) {
      cur2 = seek(video2, cur2, q2 * (video2.duration - 0.05));
      W_.__film2AtEnd = q2 >= 0.999 && !video2.seeking && Math.abs(video2.currentTime - (video2.duration - 0.05)) < 0.02;
    }
    requestAnimationFrame(tick);
  }

  if (reduce) { render(0); }
  else {
    render(0);
    load();
    // iOS needs a gesture before it will paint seeked frames reliably
    const prime = () => { video.play().then(() => video.pause()).catch(() => {}); removeEventListener('touchstart', prime); };
    addEventListener('touchstart', prime, { passive: true, once: true });
    requestAnimationFrame(tick);
  }
</script>
