---
// House walk, stop 1: the wall of my life. Real photos and papers hang in the frames of the hallway,
// one chapter per frame, in time order from left to right. Scrolling walks the camera along the wall,
// frame by frame; next to each one a little plaque tells its story (photos and papers open full screen).
import { type Locale, t } from '../i18n';
import { WALL } from '../data/wall';
import Split from './Split.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const h = (t(locale) as any).house;
const href = (x: string) => `/${locale}/${x}`;
---
<div class="hstop wstop" data-stop="wall" aria-label={h.wall_title}>
  <div class="layer">
    {WALL.map((w, i) => (
      <button type="button" class="wf" data-i={i} style={`left:${w.r.x}px;top:${w.r.y}px;width:${w.r.w}px;height:${w.r.h}px`} aria-label={h[`${w.id}_t`]}>
        <img src={w.cover} alt="" loading="lazy" decoding="async" style={`object-position:${w.pos ?? '50% 50%'}`} />
      </button>
    ))}
  </div>
  <div class="vig" aria-hidden="true"></div>
  <div class="cap rv">
    <p class="eyebrow kicker rf"><span class="no">04</span>{h.wall_eyebrow}</p>
    <h2 class="fx-hang" aria-label={h.wall_title}><Split text={h.wall_title} /></h2>
    <p class="say rf" style="--fd:.75s">{h.wall_say}</p>
  </div>
  <div class="plaques">
    {WALL.map((w, i) => (
      <article class="plaque" data-i={i}>
        {w.date && <p class="date">{w.date}</p>}
        <h3 aria-label={h[`${w.id}_t`]}><Split text={h[`${w.id}_t`]} by="word" /></h3>
        <p class="txt">{h[`${w.id}_x`]}</p>
        <div class="row">
          <div class="ths">{w.pics.map((p) => (
            <button type="button" class:list={['th', p.kind]} data-full={p.src} aria-label={h.zoom} data-cur={h.zoom}><img src={p.src} alt="" loading="lazy" decoding="async" /></button>
          ))}</div>
          {w.link && <a class="lnk" href={href(w.link.href)} data-open-book={w.link.ep}>{h[w.link.key]} →</a>}
        </div>
      </article>
    ))}
  </div>
  <dialog class="wlbx"><button type="button" class="lx" aria-label={h.close}>×</button><img alt="" /></dialog>
</div>

<style>
  .hstop { position: absolute; inset: 0; z-index: 6; opacity: 0; pointer-events: none; transition: opacity .35s ease; }
  .hstop.live { opacity: 1; pointer-events: auto; }
  .layer { position: absolute; left: 0; top: 0; width: 1920px; height: 1080px; transform-origin: 0 0; }
  /* pictures behind glass, lit by the same afternoon sun */
  .wf { all: unset; position: absolute; cursor: pointer; overflow: hidden; background: #e9dcc4; }
  .wf img { width: 100%; height: 100%; object-fit: cover; display: block; filter: sepia(.18) saturate(.92) contrast(.96) brightness(.98); }
  .wf::after { content: ''; position: absolute; inset: 0; pointer-events: none;
    box-shadow: inset 0 0 0 2px #f3ead8, inset 0 2px 8px rgba(60,30,5,.55);
    background: linear-gradient(115deg, rgba(255,230,190,.28) 0%, rgba(255,230,190,0) 38%, rgba(255,255,255,.08) 52%, rgba(255,240,210,0) 60%); }
  .wf img { transition: filter .6s ease; }
  .wstop.walking .wf:not(.cur) img { filter: sepia(.3) saturate(.6) contrast(.9) brightness(.62); }
  .vig { position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity .6s ease; background: radial-gradient(70% 80% at 34% 52%, rgba(20,10,3,0) 35%, rgba(20,10,3,.6) 100%); }
  .wstop.walking .vig { opacity: 1; }
  @media (max-width: 899px), (hover: none) { .vig { background: radial-gradient(90% 50% at 50% 28%, rgba(20,10,3,0) 30%, rgba(20,10,3,.6) 100%); } }
  .wf:focus-visible { outline: 3px solid var(--gold-hi); outline-offset: 4px; }

  .cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 120px var(--gutter-r) max(40px, 5vh) var(--gutter); display: grid; gap: 8px; justify-items: start; pointer-events: none;
    background: linear-gradient(0deg, rgba(20,11,4,.82) 0%, rgba(20,11,4,.5) 55%, rgba(20,11,4,0) 100%); opacity: var(--cap, 1); }
  .cap h2 { font-size: clamp(32px, 3.8vw, 56px); color: #fff; text-shadow: 0 2px 24px rgba(0,0,0,.35); }
  .cap .say { margin: 0; max-width: 34em; font: 500 clamp(16px, 1.2vw, 18px)/1.5 var(--f-body); color: rgba(244,238,226,.88); }

  /* the museum plaque next to the frame the camera is looking at */
  .plaque { position: absolute; left: 58vw; top: calc(50% + var(--hh, 68px) / 2); width: min(420px, 31vw); box-sizing: border-box; padding: 24px 26px 20px; display: grid; gap: 8px;
    background: rgba(247,240,225,.96); color: #2a2016; border-radius: 4px; box-shadow: 0 26px 50px -18px rgba(40,20,0,.6), inset 0 0 0 1px rgba(120,90,40,.15);
    opacity: 0; transform: translate(16px, -50%); pointer-events: none; transition: opacity .35s ease, transform .5s cubic-bezier(.2,.7,.2,1); }
  .plaque.on { opacity: 1; transform: translate(0, -50%); pointer-events: auto; }
  .plaque.pl { left: var(--gutter); }   /* this picture ends up on the right half: its plaque hangs on the left */
  /* a museum label being read: date, then the title word by word, then the story */
  :global(.js) .plaque .date, :global(.js) .plaque .txt, :global(.js) .plaque .row { opacity: 0; translate: 0 6px; transition: opacity .2s ease, translate .2s ease; }
  :global(.js) .plaque h3 :global(.w) { opacity: 0; filter: blur(4px); translate: 0 .25em; transition: opacity .2s ease, filter .2s ease, translate .2s ease; }
  .plaque.on .date, .plaque.on .txt, .plaque.on .row, .plaque.on h3 :global(.w) { opacity: 1; filter: blur(0); translate: 0 0; }
  .plaque.on .date { transition: opacity .5s ease .1s, translate .6s ease .1s; }
  .plaque.on h3 :global(.w) { transition: opacity .55s ease calc(.18s + var(--wi) * 50ms), filter .6s ease calc(.18s + var(--wi) * 50ms), translate .7s cubic-bezier(.2,.7,.2,1) calc(.18s + var(--wi) * 50ms); }
  .plaque.on .txt { transition: opacity .6s ease .45s, translate .7s ease .45s; }
  .plaque.on .row { transition: opacity .6s ease .6s, translate .7s ease .6s; }
  @media (prefers-reduced-motion: reduce) { .plaque .date, .plaque .txt, .plaque .row, .plaque h3 :global(.w) { opacity: 1 !important; filter: none !important; translate: none !important; transition: none !important; } }
  .plaque .row .ths { display: flex; gap: 8px; flex-wrap: wrap; }
  .date { margin: 0; font: 800 11px/1 var(--f-body); letter-spacing: .2em; text-transform: uppercase; color: #8a6a35; }
  .plaque h3 { margin: 0; font-size: clamp(19px, 1.6vw, 24px); line-height: 1.16; color: #1d160e; }
  .txt { margin: 0; font-size: 16px; line-height: 1.6; color: #3d3226; }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 6px; }
  .th { all: unset; cursor: zoom-in; width: 54px; height: 54px; border-radius: 3px; overflow: hidden; box-shadow: 0 0 0 1px rgba(120,90,40,.3), 0 4px 10px -4px rgba(60,35,10,.4); transition: transform .2s; }
  .th:hover, .th:focus-visible { transform: translateY(-2px) scale(1.05); }
  .th img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; }
  .th.doc img { object-position: 50% 0; }
  .lnk { margin-left: 4px; font-weight: 700; font-size: 15px; color: #7a5520; text-decoration: none; border-bottom: 1px solid currentColor; }

  /* a thin timeline: where on the wall (and in my life) we are */
  .line { position: absolute; left: var(--gutter); right: var(--gutter-r); bottom: calc(22px + env(safe-area-inset-bottom, 0px)); margin: 0; padding: 0; list-style: none; display: flex; justify-content: space-between;
    border-top: 1px solid rgba(234,211,154,.35); opacity: calc(1 - var(--cap, 1)); pointer-events: none; }
  .line li { position: relative; width: 0; }
  .line li::before { content: ''; position: absolute; left: -3px; top: -4px; width: 7px; height: 7px; border-radius: 50%; background: rgba(234,211,154,.5); }
  .line li span { position: absolute; top: 10px; left: 50%; transform: translateX(-50%); white-space: nowrap; font: 600 11px var(--f-body); letter-spacing: .06em; color: rgba(244,238,226,.55); transition: color .3s; }
  .line li.on::before { background: var(--gold-hi); box-shadow: 0 0 0 4px rgba(234,211,154,.25); }
  .line li.on span { color: var(--gold-hi); }
  .mark { position: absolute; top: -1px; left: 0; height: 1px; width: var(--prog, 0%); background: var(--gold-hi); }

  .wlbx { border: 0; padding: 0; background: transparent; max-width: 96vw; max-height: 94vh; }
  .wlbx::backdrop { background: rgba(10,8,5,.9); }
  .wlbx img { display: block; max-width: 96vw; max-height: 94vh; object-fit: contain; }
  .lx { all: unset; position: fixed; top: 16px; right: 16px; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; font-size: 28px; color: var(--ivory); cursor: pointer; border: 1px solid rgba(234,211,154,.5); }

  @media (max-width: 899px), (hover: none) {
    .cap { padding: 70px 18px calc(22px + env(safe-area-inset-bottom, 0px)); gap: 8px; justify-items: center; text-align: center; --ko: center; }
    .cap .kicker::before { margin-inline: auto; }
    .cap h2 { font-size: 32px; } .cap .say { font-size: 15px; }
    .plaque { left: 12px; right: 12px; top: auto; bottom: calc(40px + env(safe-area-inset-bottom, 0px)); width: auto; padding: 16px 18px 14px; gap: 6px; transform: translateY(12px); }
    .plaque.on { transform: none; }
    .plaque h3 { font-size: 18px; } .txt { font-size: 14.5px; line-height: 1.5; }
    .th { width: 44px; height: 44px; }
    .line { left: 14px; right: 14px; bottom: calc(14px + env(safe-area-inset-bottom, 0px)); }
    .line li span { display: none; }
  }
</style>

<script>
  import { mountStop } from '../lib/stop';
  import { stopFrame, isWide, lerpFrame, damp, type Frame } from '../lib/frame';
  import { STOPS, HOUSE } from '../data/house';
  import { WALL } from '../data/wall';
import Split from './Split.astro';

  const el = document.querySelector<HTMLElement>('.wstop');
  const sec = document.querySelector<HTMLElement>('.scrub');
  if (el && sec) {
    const W_ = window as any;
    const S = STOPS.find((s) => s.id === 'wall')!;
    const plaques = [...el.querySelectorAll<HTMLElement>('.plaque')];
    const frames = [...el.querySelectorAll<HTMLElement>('.wf')];
    const lbx = el.querySelector<HTMLDialogElement>('.wlbx')!;
    const stage = sec.querySelector<HTMLElement>('.stage')!;
    const hold = HOUSE.timeline.steps.find((s) => s.kind === 'hold' && s.stop === 'wall')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const N = WALL.length;
    const smooth = (x: number) => { x = Math.min(1, Math.max(0, x)); return x * x * (3 - 2 * x); };

    // ---- the walk is paged: every scroll gesture takes the camera one picture further, in one smooth glide.
    // Where things sit in the hold (t = 0..1 of its scroll length): the whole wall (intro band) · ten pictures,
    // each with a small rest band, evenly spaced · the whole wall again (outro band).
    const E0 = 0.024, E1 = 1 - E0, R = 0.0105;
    const L = (E1 - E0 - 2 * R * N) / (N + 1);
    const Q = (i: number) => E0 + L + R + i * (2 * R + L);
    const knots: [number, number][] = [[0, -1], [E0, -1]];
    for (let i = 0; i < N; i++) knots.push([Q(i) - R, i], [Q(i) + R, i]);
    knots.push([E1, N], [1, N]);
    // which picture the scroll position is at: whole numbers on the rest bands, fractions in between, -1 / N = the whole wall
    const cAt = (t: number) => {
      if (t <= 0) return -1;
      for (let j = 1; j < knots.length; j++) {
        const [t1, c1] = knots[j];
        if (t <= t1) { const [t0, c0] = knots[j - 1]; return t1 > t0 ? c0 + (c1 - c0) * (t - t0) / (t1 - t0) : c1; }
      }
      return N;
    };
    const tOf = (c: number) => (c <= -1 ? E0 * 0.6 : c >= N ? (E1 + 1) / 2 : Q(c));
    const vh = () => stage.clientHeight / 100;
    const from = () => HOUSE.timeline.start * 1000 + hold.from;
    const tAtY = (y: number) => ((y - (sec.getBoundingClientRect().top + scrollY)) / vh() - from()) / hold.len;   // hold progress at page offset y
    const rawT = () => tAtY(scrollY);
    const topFor = (t: number) => sec.getBoundingClientRect().top + scrollY + (from() + t * hold.len) * vh();

    // ---- the camera: T = the picture it is heading to; c glides after it (two soft springs = gentle start, gentle stop)
    let T = -1, c = -1, cv = 0, m = -1, mv = 0, clock = -1, ready = false, outside = true;
    const clampT = (x: number) => Math.max(-1, Math.min(N, x));
    const advance = () => {
      const now = Number(document.timeline?.currentTime ?? performance.now());
      if (now === clock) return;                       // once per frame, whoever asks first
      const dt = clock < 0 ? 0 : Math.min(0.05, (now - clock) / 1000);
      clock = now;
      if (!ready) {
        const t = rawT(); outside = t < 0 || t > 1;
        T = t < 0 ? -1 : t > 1 ? N : Math.round(cAt(t)); c = m = T; ready = true; return;
      }
      // out of the hold the camera hurries back to the whole wall, so the next move starts where it should;
      // inside, a long fling never races past more than ~8 pictures a second
      [m, mv] = damp(m, T, mv, outside ? 0.06 : 0.11, dt, outside ? 40 : 8);
      [c, cv] = damp(c, m, cv, outside ? 0.14 : 0.25, dt);
      if (Math.abs(c - T) < 2e-4 && Math.abs(m - T) < 2e-4 && Math.abs(cv) < 2e-3) { c = m = T; cv = mv = 0; }
    };

    // ---- framing. Desktop: one steady zoom for the whole walk, the picture big on the left and its plaque next to it;
    // phone: each picture as big as the screen allows, the plaque below.
    function target(i: number, base: Frame, W: number, H: number, hh: number): Frame {
      const r = WALL[i].r, wide = isWide();
      const availH = wide ? H - hh : H * 0.58 - hh;
      const k = wide ? Math.min(base.k * 2.8, (availH * 0.5) / 200) : Math.min(base.k * 3, (W * 0.84) / r.w, (availH * 0.82) / r.h);
      const cx = wide ? W * 0.34 : W / 2, cy = hh + availH / 2;
      let left = cx - (r.x + r.w / 2) * k, top = cy - (r.y + r.h / 2) * k;
      left = Math.max(W - 1920 * k, Math.min(0, left)); top = Math.max(H - 1080 * k, Math.min(0, top));
      return { k, left, top };
    }
    // the camera between pictures lives in "camera space": the wall point under the anchor (X, Y) and the zoom (log k)
    type Cam = { X: number; Y: number; lk: number };
    let geoKey = '', base: Frame = { k: 1, left: 0, top: 0 }, cams: Cam[] = [], ax = 0, ay = 0;
    function geometry(W: number, H: number, hh: number) {
      const wide = isWide(), key = `${W}x${H}x${hh}x${wide}`;
      if (key === geoKey) return;
      geoKey = key;
      const keep = W_.__stopFrame.wall; W_.__stopFrame.wall = null;
      base = stopFrame(S, W, H, hh, 0);
      W_.__stopFrame.wall = keep;
      const availH = wide ? H - hh : H * 0.58 - hh;
      ax = wide ? W * 0.34 : W / 2; ay = hh + availH / 2;
      const fr = [base, ...WALL.map((_, i) => target(i, base, W, H, hh)), base];   // [whole wall, picture 0 … 9, whole wall]
      cams = fr.map((f) => ({ X: (ax - f.left) / f.k, Y: (ay - f.top) / f.k, lk: Math.log(f.k) }));
      // the plaque stays on one side per picture (decided here, never flipping while the camera moves)
      plaques.forEach((p, i) => { const f = fr[i + 1], r = WALL[i].r; p.classList.toggle('pl', wide && f.left + (r.x + r.w / 2) * f.k > W * 0.5); });
    }
    const TEN = 0.32;   // how much of its sideways drift the camera carries through a picture (0 = straight lines)
    function camFrame(cc: number, W: number, H: number): Frame {
      const j = cc + 1;                                   // 0 = whole wall, 1..N = pictures, N + 1 = whole wall
      if (j <= 0 || j >= N + 1) return base;
      const a = Math.floor(j), s = j - a, A = cams[a], B = cams[a + 1];
      let X: number, Y: number;
      if (a === 0 || a === N) { X = A.X + (B.X - A.X) * s; Y = A.Y + (B.Y - A.Y) * s; }   // zooming in from / out to the whole wall
      else {
        // picture to picture: a soft curve through the pictures (cardinal spline), so passing several never zigzags
        const tan = (q: number, key: 'X' | 'Y') => {
          const prev = q > 1 ? cams[q - 1][key] : 2 * cams[q][key] - cams[q + 1][key];
          const next = q < N ? cams[q + 1][key] : 2 * cams[q][key] - cams[q - 1][key];
          return TEN * (next - prev);
        };
        const s2 = s * s, s3 = s2 * s, h00 = 2 * s3 - 3 * s2 + 1, h10 = s3 - 2 * s2 + s, h01 = -2 * s3 + 3 * s2, h11 = s3 - s2;
        X = h00 * A.X + h10 * tan(a, 'X') + h01 * B.X + h11 * tan(a + 1, 'X');
        Y = h00 * A.Y + h10 * tan(a, 'Y') + h01 * B.Y + h11 * tan(a + 1, 'Y');
      }
      const k = Math.exp(A.lk + (B.lk - A.lk) * s), iw = 1920 * k, ih = 1080 * k;
      let left = ax - X * k, top = ay - Y * k;
      if (a > 0 && a < N) {   // never show an edge of the picture on the way
        left = Math.max(Math.min(0, W - iw), Math.min(Math.max(0, W - iw), left));
        top = Math.max(Math.min(0, H - ih), Math.min(Math.max(0, H - ih), top));
      }
      return { k, left, top };
    }
    W_.__stopFrame ??= {};
    W_.__stopFrame.wall = (W: number, H: number, hh: number) => {
      geometry(W, H, hh);
      if (W_.__stop !== 'wall') return base;
      advance();
      // at the very ends of the hold the frame is exactly the whole wall, where the moves in and out begin
      const t = W_.__stopT ?? 0, g = Math.min(smooth(t / 0.012), smooth((1 - t) / 0.012));
      const cam = camFrame(c, W, H), f = g >= 1 ? cam : lerpFrame(base, cam, g);
      return { k: f.k, left: Math.round(f.left * 100) / 100, top: Math.round(f.top * 100) / 100 };
    };

    // ---- what the visitor sees around the camera
    let shownPl = -2, shownCur = -2;
    const update = () => {
      advance();
      const at = T >= 0 && T < N && Math.abs(c - T) < 0.14 ? T : -1;   // the plaque comes when the camera arrives
      if (at !== shownPl) { shownPl = at; plaques.forEach((p, i) => p.classList.toggle('on', i === at)); }
      const cur = T >= 0 && T < N ? T : -1;                             // the picture we are heading to lights up at once
      if (cur !== shownCur) { shownCur = cur; frames.forEach((f, i) => f.classList.toggle('cur', i === cur)); el.classList.toggle('walking', cur >= 0); }
      const cap = c < -0.5 ? 1 - smooth((c + 1) / 0.5) : c > N - 0.5 ? smooth((c - (N - 0.5)) / 0.5) : 0;
      el.style.setProperty('--cap', cap.toFixed(3));
    };

    // ---- scrolling → which picture. A new gesture (wheel notch, swipe, arrow key) goes one picture on;
    // a long scroll or fling carries on through the pictures it passes. When the page comes to rest,
    // it settles on the picture the camera went to, so the next gesture starts from there.
    let lastY = scrollY, dir = 0, touching = false, touchY = 0, touchArm = false, lastWheel = -1e9, idle = 0;
    let pend: { dir: number; at: number; acc: number; done: boolean } | null = null;
    // (a gesture that starts outside the wall only brings you to it: you arrive at the whole wall first;
    // judged by where the page was before the gesture, the browser may already have moved it when we hear of it)
    const arm = (d: number) => { const t = tAtY(lastY); pend = t >= 0 && t <= 1 ? { dir: d, at: performance.now(), acc: 0, done: false } : null; };
    const kick = () => { clearTimeout(idle); idle = window.setTimeout(settle, 170); };
    function settle() {
      if (touching || reduce || lbx.open) return;
      const t = rawT();
      if (t < 0 || t > 1 || Math.abs(cAt(t) - T) < 1e-6) return;
      scrollTo({ top: topFor(tOf(T)), behavior: 'smooth' });
    }
    addEventListener('wheel', (e) => {
      if (!e.deltaY || e.ctrlKey || Math.abs(e.deltaY) < Math.abs(e.deltaX)) return;
      const now = performance.now();
      if (now - lastWheel > 180) arm(Math.sign(e.deltaY));          // a pause before it: a new gesture
      lastWheel = now; kick();
    }, { passive: true });
    addEventListener('touchstart', (e) => { touching = true; touchArm = true; touchY = e.touches[0]?.clientY ?? 0; clearTimeout(idle); }, { passive: true });
    addEventListener('touchmove', (e) => {
      if (!touchArm) return;
      const dy = touchY - (e.touches[0]?.clientY ?? touchY);
      if (Math.abs(dy) > 10) { touchArm = false; arm(Math.sign(dy)); }
    }, { passive: true });
    const lift = (e: TouchEvent) => { touching = e.touches.length > 0; if (!touching) kick(); };
    addEventListener('touchend', lift, { passive: true });
    addEventListener('touchcancel', lift, { passive: true });
    const KEYS: Record<string, number> = { ArrowDown: 1, PageDown: 1, ' ': 1, ArrowUp: -1, PageUp: -1 };
    addEventListener('keydown', (e) => {
      const d = KEYS[e.key];
      if (d && !e.repeat && !e.altKey && !e.ctrlKey && !e.metaKey) arm(e.key === ' ' && e.shiftKey ? -1 : d);
    });
    addEventListener('scroll', () => {
      const y = scrollY, dy = y - lastY, t0 = tAtY(lastY);
      lastY = y;
      if (dy) dir = Math.sign(dy);
      const t = tAtY(y);
      outside = t < 0 || t > 1;
      if (outside) { T = t < 0 ? -1 : N; pend = null; kick(); return; }
      if (t0 < 0 || t0 > 1) pend = null;   // just came in from outside
      // the gesture counts once the page really moved its way (a wheel over a scrolling box, or a tap on a button, does not)
      if (pend && !pend.done && dy && Math.sign(dy) === pend.dir && performance.now() - pend.at < 700) {
        pend.acc += Math.abs(dy);
        if (pend.acc >= 12) { pend.done = true; T = clampT(T + pend.dir); }
      }
      // and the camera is never behind the scroll position itself
      const cr = cAt(t);
      if (dir > 0) T = Math.max(T, Math.ceil(cr - 1e-6));
      else if (dir < 0) T = Math.min(T, Math.floor(cr + 1e-6));
      kick();
    }, { passive: true });

    // click a frame: walk straight there
    const scrollToFrame = (i: number) => { T = i; scrollTo({ top: topFor(Q(i)), behavior: 'smooth' }); };
    frames.forEach((b) => b.addEventListener('click', () => scrollToFrame(Number(b.dataset.i))));
    el.querySelectorAll<HTMLButtonElement>('.th').forEach((th) => th.addEventListener('click', () => { lbx.querySelector('img')!.src = th.dataset.full!; lbx.showModal(); }));
    lbx.addEventListener('click', () => lbx.close());

    // the film waits at the wall's edge while the camera is still zooming back out to the whole wall (after a fast fling)
    (W_.__holdBusy ??= {}).wall = (side: number) => Math.abs(c - (side > 0 ? N : -1)) > 0.02;

    mountStop('wall', el, { onFrame: () => update() });
    // the camera keeps gliding between scroll events, so the plaques and the springs run every frame
    const loop = () => { advance(); if (W_.__stop === 'wall') update(); requestAnimationFrame(loop); };
    requestAnimationFrame(loop);
  }
</script>
