---
import { type Locale, t } from '../i18n';
import { EPISODES, INSTAGRAM } from '../data/episodes';
import Split from './Split.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const s = t(locale);
const lines = s.ep as Record<string, { line: string }>;
const topics = s.topics as Record<string, string>;
const E = s.episodes as Record<string, string>;
const play = E.play ?? 'Play episode';
const close = E.close ?? 'Close';
const pull = E.pull ?? 'Pull out a book';
// book edges measured on the last frame of the scroll film (1920x1080)
import { SHELF } from '../data/shelf';
const EDGES = SHELF.edges;
const BOOK_TOP = SHELF.top, BOOK_BOTTOM = SHELF.bottom;
const sceneVars = `--num-top:${SHELF.numTop}px;--num-h:${SHELF.numH}px;--num-size:${SHELF.numSize}px;--caption-top:${SHELF.captionTop}px`;
---
<div class="scene-wrap" id="shelf">
  <div class="scene" aria-label={s.episodes.eyebrow}>
    <div class="sfill" aria-hidden="true"></div>
    <div class="f1920" style={sceneVars}>
      <img class="sbg" src="/assets/img/shelf-scene-v2.jpg" width="1920" height="1080" alt="" decoding="async" />
      <p class="wall rv"><span class="weye rf" style="--fd:.1s"><span class="no">02</span>{s.episodes.eyebrow}</span><span class="wpull fx-flap" aria-label={pull}><Split text={pull} /></span><span class="wmore rf" style="--fd:.85s">{E.more_title ?? ''}</span></p>
      {EPISODES.map((e, i) => {
        const x0 = EDGES[i], w = EDGES[i + 1] - EDGES[i];
        return (
          <button type="button" class="sbook" data-n={e.n} aria-label={`${e.n} · ${e.title}`} data-cur={`${e.n} · ${e.title}`} style={`left:${x0}px;width:${w}px;top:${BOOK_TOP}px;height:${BOOK_BOTTOM - BOOK_TOP}px`}>
            <span class="slot" aria-hidden="true" style={`background-position:-${x0}px -${BOOK_TOP}px`}></span>
            <span class="slice" aria-hidden="true" style={`background-position:-${x0}px -${BOOK_TOP}px`}><span class="snum">{e.n}</span></span>
          </button>
        );
      })}
    </div>
    <div class="cap-bar rv" aria-live="polite">
      <span class="cb-eye kicker center rf"><span class="no">02</span>{s.episodes.eyebrow}</span>
      <p class="cb-title fx-flap"></p>
      <div class="cb-row rf" style="--fd:.35s"><button type="button" class="cb-open">{E.open ?? 'Open the book'}</button></div>
    </div>
    <div class="reader" hidden><div class="rback"></div></div>
  </div>
</div>
<section class="block light episodes" id="episodes">
  <div class="wrap">
    <div class="sec-head split" data-reveal>
      <p class="eyebrow kicker">{s.episodes.eyebrow}</p>
      <h2>{s.episodes.title}</h2>
      <p class="muted">{s.episodes.intro}</p>
    </div>
  </div>
  <div class="shelf-wrap">
    <p class="hint">{pull} <span aria-hidden="true">↓</span></p>
    <ol class="shelf" data-labels={JSON.stringify({ out: s.episodes.out, soon: s.episodes.soon, prod: s.episodes.production })} data-locale={locale}>
      {EPISODES.map((e) => (
        <li class="book" data-date={e.date ?? ''} data-n={e.n}>
          <div class="vol"><span class="top" aria-hidden="true"></span>
          <button type="button" class="spine" aria-expanded="false" aria-label={`${e.n} · ${e.title}`}>
            <span class="art" aria-hidden="true"></span>
            <span class="cap"><span class="num">{e.n}</span></span>
            <span class="plate"><span class="stitle">{e.title}</span><span class="dot"></span></span>
          </button></div>
          <div class="pages">
            <a href={e.yt ? `https://www.youtube.com/shorts/${e.yt[0]}` : INSTAGRAM} target="_blank" rel="noopener" class="page cover" data-n={e.n} data-yt={e.yt ? e.yt.join(',') : undefined} data-title={e.title} aria-label={e.yt ? `${play}: ${e.title}` : s.episodes.watch}>
              <span class="bg" style={e.image ? `background-image:url(${e.image})` : undefined}></span>
              {e.image && <video class="clip" muted loop playsinline preload="none" aria-hidden="true" data-src={e.image.replace('.jpg', '.mp4')}></video>}
              {e.yt && <span class="playbtn" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z"/></svg></span>}
            </a>
            <div class="page story">
              <button type="button" class="shut" aria-label={close}>✕</button>
              <span class="bign" aria-hidden="true">{e.n}</span>
              <span class="row"><span class="tag">{topics[e.topic]}</span><span class="status"></span></span>
              <h3 class="title">{e.title}</h3>
              <span class="rule" aria-hidden="true"></span>
              <p class="line">{lines[e.n]?.line}</p>
              {e.parts && <p class="parts">{s.episodes.parts}: {e.parts.join(' · ')}</p>}
              {e.yt
                ? <a class="go play" href={`https://www.youtube.com/shorts/${e.yt[0]}`} data-n={e.n} data-yt={e.yt.join(',')} data-title={e.title}><span class="pi" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z"/></svg></span><span>{play}</span></a>
                : <a class="go link" href={INSTAGRAM} target="_blank" rel="noopener">{s.episodes.watch} →</a>}
            </div>
          </div>
        </li>
      ))}
    </ol>
    <div class="plank" aria-hidden="true"></div>
    <div class="more">
      <div class="ghosts" aria-hidden="true">{['II','III','IV','V'].map((r) => <span class="ghost"><i>{r}</i></span>)}</div>
      <div class="more-text">
        <p class="eyebrow">{E.more_eyebrow ?? 'Coming next'}</p>
        <p class="more-title">{E.more_title ?? 'More seasons are in production.'}</p>
        <p class="muted">{E.more_text ?? 'So much more to learn. Follow along so you don\'t miss the next shelf.'}</p>
      </div>
    </div>
  </div>
  <dialog class="player" aria-label={play}>
    <div class="pbox">
      <div class="ptop"><span class="ptitle"></span><button type="button" class="pclose" aria-label={close}>✕</button></div>
      <div class="frame"></div>
      <div class="pparts"></div>
    </div>
  </dialog>
</section>

<style>
  .episodes { overflow: hidden; }
  .shelf-wrap { position: relative; padding-left: var(--gutter); padding-right: var(--gutter-r); max-width: calc(var(--max) + 400px); margin: 0 auto; }
  .hint { margin: 0 0 14px; font: 700 12px var(--f-body); letter-spacing: .18em; text-transform: uppercase; color: var(--gold-deep); }
  .shelf { list-style: none; margin: 0; padding: 0; display: flex; gap: 3px; align-items: flex-end; }
  .book { position: relative; }
  .spine { all: unset; box-sizing: border-box; cursor: pointer; position: relative; display: block; width: 100%; height: 100%; overflow: hidden; border-radius: 3px 3px 2px 2px; background: #17120c; }

  /* the picture printed across all spines */
  .art { position: absolute; top: 0; bottom: 0; left: calc(var(--ox, 0) * -1px); width: calc(var(--rw, 1200) * 1px);
    background: url(/assets/img/pano.jpg) center 40% / cover no-repeat; }
  /* rounded leather spine shading on top of the picture */
  .spine::after { content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(90deg, rgba(0,0,0,.5) 0, rgba(0,0,0,.08) 12%, rgba(255,240,210,.12) 36%, rgba(0,0,0,0) 60%, rgba(0,0,0,.4) 100%), linear-gradient(0deg, rgba(0,0,0,.25), rgba(0,0,0,0) 30%); }
  .cap { position: absolute; z-index: 1; top: 16px; left: 50%; transform: translateX(-50%); width: min(64px, calc(100% - 14px)); height: 54px; display: grid; place-items: center;
    background: linear-gradient(180deg, #1d160e, #110d08); border: 1px solid rgba(234,211,154,.6); border-radius: 3px; box-shadow: 0 4px 10px rgba(0,0,0,.45), inset 0 0 0 3px #15100a, inset 0 0 0 4px rgba(234,211,154,.28); }
  .num { font-family: var(--f-display); font-size: 26px; font-weight: 600; color: var(--gold-hi); font-variant-numeric: lining-nums; }
  .plate { position: absolute; z-index: 1; top: 86px; bottom: 16px; left: 50%; transform: translateX(-50%); width: 32px; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 12px; padding: 12px 0;
    background: linear-gradient(90deg, #110d08, #211910 50%, #110d08); border: 1px solid rgba(234,211,154,.6); border-radius: 3px; box-shadow: 0 4px 12px rgba(0,0,0,.45), inset 0 0 0 2px #15100a, inset 0 0 0 3px rgba(234,211,154,.25); }
  .stitle { writing-mode: vertical-rl; transform: rotate(180deg); font: 700 11.5px/1 var(--f-body); letter-spacing: .14em; text-transform: uppercase; color: #f6efdf; white-space: nowrap; }
  .dot { width: 7px; height: 7px; border-radius: 50%; border: 1px solid rgba(234,211,154,.7); flex: none; }
  .book.out .dot { background: var(--gold); border-color: var(--gold); }

  .pages { display: none; }
  .page { position: relative; display: block; overflow: hidden; }
  .cover { text-decoration: none; background: #15120d; color: var(--ivory); }
  .bg { position: absolute; inset: 0; background: radial-gradient(120% 90% at 60% 30%, #3a2f1c 0%, #15120d 70%); background-size: cover; background-position: center; }
  .clip { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .5s ease; }
  .book.playing .clip { opacity: 1; }
  .cover::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,0) 80%, rgba(0,0,0,.35)); pointer-events: none; }
  .playbtn { position: absolute; z-index: 3; left: 50%; top: 50%; width: 84px; height: 84px; margin: -42px 0 0 -42px; border-radius: 50%;
    display: grid; place-items: center; background: rgba(13,12,10,.4); border: 1.5px solid rgba(234,211,154,.9);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); box-shadow: 0 10px 40px rgba(0,0,0,.35); transition: transform .35s cubic-bezier(.2,.7,.2,1), background .35s; }
  .playbtn::before { content: ''; position: absolute; inset: -9px; border-radius: 50%; border: 1px solid rgba(234,211,154,.4); animation: ring 2.6s ease-out infinite; }
  .playbtn svg { width: 30px; height: 30px; margin-left: 4px; fill: var(--gold-hi); }
  .cover:hover .playbtn, .cover:focus-visible .playbtn { transform: scale(1.08); background: var(--gold); }
  .cover:hover .playbtn svg, .cover:focus-visible .playbtn svg { fill: #1a1408; }
  @keyframes ring { 0% { transform: scale(.92); opacity: .9; } 100% { transform: scale(1.35); opacity: 0; } }

  .story { padding: 30px 30px 28px; display: flex; flex-direction: column; gap: 12px; color: #1c1914;
    background:
      linear-gradient(90deg, rgba(60,40,10,.18), rgba(60,40,10,0) 7%),
      repeating-linear-gradient(0deg, transparent 0 27px, rgba(138,100,36,.07) 27px 28px),
      #f8f2e4; }
  .bign { font-family: var(--f-head); font-size: 58px; font-weight: 800; line-height: .9; letter-spacing: -0.03em; color: var(--gold-deep); font-variant-numeric: lining-nums; }
  .row { display: flex; justify-content: space-between; gap: 10px; align-items: center; }
  .tag { font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--gold-deep); }
  .status { font-size: 11px; font-weight: 700; letter-spacing: .06em; border: 1px solid rgba(138,100,36,.45); color: #5c4520; border-radius: 999px; padding: 3px 10px; white-space: nowrap; }
  .status.out { background: var(--gold); color: #1a1408; border-color: var(--gold); }
  .status:empty { display: none; }
  .title { margin: 0; font-size: clamp(21px, 1.8vw, 27px); line-height: 1.16; }
  .rule { width: 46px; height: 2px; background: var(--grad-gold, var(--gold)); }
  .line { margin: 0; font-size: 16px; line-height: 1.55; color: #3b342a; }
  .parts { margin: 0; font-size: 13px; color: var(--muted-light); }
  .go { margin-top: auto; align-self: flex-start; }
  .go.link { font-weight: 700; color: var(--gold-deep); text-decoration: none; }
  .shut { position: absolute; top: 14px; right: 14px; width: 36px; height: 36px; border-radius: 50%; border: 1px solid rgba(138,100,36,.4); background: none; color: #5c4520; cursor: pointer; font-size: 14px; }

  .go.play { display: inline-flex; align-items: center; gap: 12px; padding: 8px 22px 8px 8px; border-radius: 999px; text-decoration: none; font: 700 15px var(--f-body); color: #1a1408;
    background: var(--grad-gold, var(--gold)); box-shadow: 0 10px 24px -10px rgba(138,100,36,.7); transition: transform .3s cubic-bezier(.2,.7,.2,1), box-shadow .3s; }
  .go.play:hover { transform: translateY(-2px); box-shadow: 0 14px 30px -10px rgba(138,100,36,.8); }
  .pi { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: #1a1408; }
  .pi svg { width: 18px; height: 18px; margin-left: 3px; fill: var(--gold-hi); }
  .more { display: flex; align-items: center; gap: 40px; margin-top: 56px; }
  .ghosts { display: flex; gap: 6px; align-items: flex-end; flex: none; }
  .ghost { width: 34px; height: 150px; border: 1.5px dashed rgba(138,100,36,.45); border-radius: 3px; display: grid; place-items: start center; padding-top: 12px; }
  .ghost:nth-child(2) { height: 132px; } .ghost:nth-child(3) { height: 160px; } .ghost:nth-child(4) { height: 120px; }
  .ghost i { font: 600 15px var(--f-display); font-style: normal; color: rgba(138,100,36,.7); }
  .more-title { margin: 6px 0 6px; font: 800 clamp(19px, 1.9vw, 25px)/1.18 var(--f-head); letter-spacing: -0.01em; text-transform: uppercase; }
  .more .muted { margin: 0; max-width: 34em; }
  .plank { height: 18px; margin-top: 0; border-radius: 2px;
    background: linear-gradient(180deg, #6b4a2b, #4a311b 60%, #2e1f12); box-shadow: 0 14px 24px -10px rgba(40,25,10,.55), inset 0 1px 0 rgba(255,220,170,.25); }

  /* player */
  .player { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh; }
  .player::backdrop { background: rgba(13,12,10,.86); backdrop-filter: blur(6px); }
  .pbox { --fw: min(460px, 94vw, calc((100dvh - 120px) * 9 / 16)); width: var(--fw); display: grid; gap: 12px; color: var(--ivory); }
  .ptop { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .ptitle { font: 800 17px/1.2 var(--f-head); letter-spacing: -0.01em; text-transform: uppercase; }
  .pclose { background: none; border: 1px solid rgba(234,211,154,.4); color: var(--ivory); width: 40px; height: 40px; border-radius: 50%; cursor: pointer; font-size: 16px; }
  .frame { position: relative; width: var(--fw); height: calc(var(--fw) * 16 / 9); border-radius: 14px; overflow: hidden; background: #000; }
  .frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block; }
  .pparts { display: flex; gap: 8px; flex-wrap: wrap; }
  .pparts :global(button) { background: none; border: 1px solid rgba(234,211,154,.4); color: var(--ivory); border-radius: 999px; padding: 8px 14px; cursor: pointer; font: 600 13px var(--f-body); }
  .pparts :global(button[aria-pressed='true']) { background: var(--gold); color: #1a1408; border-color: var(--gold); }

  /* Desktop: the bookshelf */
  @media (min-width: 900px) and (hover: hover) {
    .shelf { height: min(580px, 70vh); }
    .shelf { perspective: 1700px; perspective-origin: 50% -30%; }
    .book { flex: 1 1 0; min-width: 0; height: 100%; transform-style: preserve-3d; transition: flex-basis .7s cubic-bezier(.2,.7,.2,1), flex-grow .7s cubic-bezier(.2,.7,.2,1); }
    .vol { position: relative; height: 100%; transform-style: preserve-3d; transform: translateZ(-26px); transition: transform .45s cubic-bezier(.2,.7,.2,1); }
    .top { position: absolute; left: 0; right: 0; top: 0; height: 52px; transform-origin: top center; transform: rotateX(-90deg);
      background: repeating-linear-gradient(90deg, #efe4cc 0 2px, #d9cbad 2px 3px), #eadfc6; border: 1px solid #2a1f14; border-left-width: 3px; border-right-width: 3px; }
    .spine { box-shadow: inset -1px 0 0 rgba(0,0,0,.6); }
    .book:not(.open):hover .vol, .book:not(.open):has(.spine:focus-visible) .vol { transform: translateZ(18px) translateY(-16px) rotateY(-4deg); }
    .book:not(.open):hover .spine { box-shadow: 0 26px 34px -14px rgba(0,0,0,.6); }
    .book:not(.open) .spine:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
    .plank { position: relative; z-index: 2; height: 22px; transform-style: preserve-3d; }
    .book.open { flex: 0 0 min(820px, 58%); }
    .book.open .vol { display: none; }
    .pages { position: absolute; inset: 0; display: grid; grid-template-columns: 1fr 1fr; perspective: 1800px; opacity: 0; pointer-events: none;
      padding: 6px; border-radius: 8px; background: linear-gradient(90deg, #2a1d12, #3a2817 49%, #1a120a 50%, #3a2817 51%, #2a1d12); box-shadow: 0 30px 50px -24px rgba(0,0,0,.7); }
    .book.open .pages { opacity: 1; pointer-events: auto; transition: opacity .25s ease .25s; }
    .cover { border-radius: 6px 0 0 6px; box-shadow: -10px 16px 30px -18px rgba(0,0,0,.6); }
    .story { border-radius: 0 6px 6px 0; transform-origin: left center; transform: rotateY(-100deg);
      box-shadow: 1px 1px 0 #e6dcc6, 2px 2px 0 #cfc2a5, 3px 3px 0 #e6dcc6, 4px 4px 0 #c4b697, 5px 5px 0 #e6dcc6, 6px 6px 0 #b9aa8a; }
    .cover { box-shadow: -1px 1px 0 #e6dcc6, -2px 2px 0 #cfc2a5, -3px 3px 0 #e6dcc6, -4px 4px 0 #c4b697, -5px 5px 0 #e6dcc6, -6px 6px 0 #b9aa8a !important; }
    .book.open .story { transform: rotateY(0); transition: transform .9s cubic-bezier(.2,.7,.2,1) .35s; }
  }
  /* Phone/tablet: open books as swipeable cards */
  @media (max-width: 899px), (hover: none) {
    .hint, .plank, .vol { display: none; }
    .more { gap: 20px; margin-top: 32px; } .ghost { width: 22px; height: 96px !important; } .ghost i { font-size: 11px; }
    .shelf { overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 12px; scrollbar-width: none; gap: 12px; align-items: stretch; }
    .shelf::-webkit-scrollbar { display: none; }
    .book { flex: 0 0 min(80vw, 340px); scroll-snap-align: start; }
    .pages { display: grid; grid-template-rows: auto 1fr; height: 100%; border-radius: 14px; overflow: hidden; box-shadow: 0 14px 30px -18px rgba(0,0,0,.5); }
    .cover { aspect-ratio: 1 / 1; }
    .story { padding: 22px 22px 24px; background: #f8f2e4; }
    .bign { font-size: 44px; }
    .shut { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .playbtn::before { animation: none; }
    .book, .story, .spine { transition: none !important; }
  }

  /* ---------- Shelf scene = last frame of the scroll film, 1:1 ---------- */
    .scene-wrap { display: block; position: absolute; left: 0; width: 1px; height: 1px; top: calc(55% - 55vh); pointer-events: none; }
    .scene { position: absolute; inset: 0; z-index: 4; overflow: hidden; background: transparent; opacity: 0; pointer-events: none; transition: opacity .35s ease; }
    .scene.live { opacity: 1; pointer-events: auto; }
    .sfill { display: none; position: absolute; inset: -40px; background: url(/assets/img/shelf-scene-v2.jpg) center / cover; filter: blur(26px) brightness(.42) saturate(1.1); }
    .f1920 { position: absolute; left: 0; top: 0; width: 1920px; height: 1080px; transform-origin: 0 0; }
    .sbg { display: none; } /* the film itself stays underneath: nothing is ever swapped */
    .wall { position: absolute; left: 0; right: 0; top: var(--caption-top); margin: 0; display: flex; justify-content: center; align-items: baseline; gap: 26px; color: #f2d48e; opacity: 0; transition: opacity .3s ease; }
    .scene.live .wall { opacity: 1; }
    .wmore { font: 500 18px var(--f-body); color: rgba(244,238,226,.78); }
    /* on desktop the shelf scene replaces the flat list; keep the section only as a host for the player dialog */
    :global(.js:not(.nofilm)) .episodes { padding: 0 !important; background: var(--ink) !important; }
    :global(.js:not(.nofilm)) .episodes > .wrap, :global(.js:not(.nofilm)) .episodes > .shelf-wrap { display: none !important; }
    .weye { font: 700 16px var(--f-body); letter-spacing: .28em; text-transform: uppercase; color: #d9b46a; }
    .weye .no::after { content: '—'; margin: 0 .55em; }
    /* the desktop shelf's own title flips in like a departures board, as the phone caption does (fx-flap) */
    .wpull { font: 800 38px/1 var(--f-head); text-transform: uppercase; letter-spacing: -0.01em; color: #fff; text-shadow: 0 2px 14px rgba(0,0,0,.75); }
    .wpull.go :global(.c) { transition-delay: calc(.2s + var(--i) * 30ms); }
    .sbook { all: unset; position: absolute; cursor: pointer; }
    .slot { position: absolute; inset: 0; background-image: url(/assets/img/shelf-empty-v2.jpg); background-size: 1920px 1080px; box-shadow: inset 0 18px 18px -12px rgba(20,10,3,.6); opacity: 0; transition: opacity 0s .45s; }
    .sbook:hover .slot, .sbook.hov .slot, .sbook:focus-visible .slot { opacity: 1; transition-delay: 0s; }
    .dim { position: absolute; left: 116px; top: 96px; width: 1648px; height: 786px; border-radius: 10px; pointer-events: none;
      box-shadow: 0 0 120px 1600px rgba(16,9,3,.5); opacity: 0; transition: opacity 1.2s ease .35s; }
    .lip { position: absolute; left: 0; right: 0; top: 879px; height: 4px; pointer-events: none; background: linear-gradient(90deg, transparent, rgba(255,214,150,.55) 12%, rgba(255,226,170,.75) 50%, rgba(255,214,150,.55) 88%, transparent);
      box-shadow: 0 0 14px rgba(255,200,120,.45); opacity: 0; transition: opacity 1.2s ease .35s; }
    .edge { position: absolute; inset: -2px; pointer-events: none; box-shadow: inset 0 0 140px 60px rgba(14,8,3,.92); opacity: 0; transition: opacity 1.2s ease .35s; }
    .scene.live .dim, .scene.live .lip, .scene.live .edge { opacity: 1; }
    .slice::after { content: ''; position: absolute; inset: 0; border-radius: 4px; pointer-events: none; opacity: 0; transition: opacity 1.2s ease .35s;
      box-shadow: inset 2px 0 0 rgba(255,228,175,.28), inset -3px 0 0 rgba(0,0,0,.5), inset 0 2px 0 rgba(255,228,175,.25);
      background: linear-gradient(90deg, rgba(0,0,0,.28), rgba(0,0,0,0) 10%, rgba(255,235,190,.07) 40%, rgba(0,0,0,0) 70%, rgba(0,0,0,.3)); }
    .scene.live .slice::after { opacity: 0; }
    .slice { position: absolute; inset: 0; border-radius: 4px; transition: transform .45s cubic-bezier(.2,.7,.2,1), box-shadow .45s; }
    /* the cut-out book only appears while it moves; at rest the film frame underneath is what you see */
    .slice::before { content: ''; position: absolute; inset: 0; border-radius: 4px; background-image: var(--shelf-img, url(/assets/img/shelf-scene-v2.jpg)); background-size: 1920px 1080px; background-position: inherit; opacity: 0; transition: opacity 0s .45s; }
    .sbook:hover .slice::before, .sbook.hov .slice::before, .sbook:focus-visible .slice::before { opacity: 1; transition-delay: 0s; }
    .snum { z-index: 1; }
    .sbook:hover .slice, .sbook.hov .slice, .sbook:focus-visible .slice { transform: translateY(-26px); box-shadow: 0 28px 30px -16px rgba(0,0,0,.7); }
    .sbook:focus-visible { outline: none; }
    .snum { position: absolute; left: 14px; right: 14px; top: var(--num-top); height: var(--num-h); display: grid; place-items: center; font: 600 var(--num-size) var(--f-display); color: #f2d48e; font-variant-numeric: lining-nums;
      text-shadow: 0 1px 0 rgba(0,0,0,.7), 0 0 12px rgba(255,200,110,.35); opacity: 0; transform: scale(.9); transition: opacity .7s ease, transform .7s ease; }
    .scene.live .snum { opacity: 1; transform: none; }
    .sbook:nth-of-type(2) .snum { transition-delay: .04s } .sbook:nth-of-type(3) .snum { transition-delay: .08s } .sbook:nth-of-type(4) .snum { transition-delay: .12s }
    .sbook:nth-of-type(5) .snum { transition-delay: .16s } .sbook:nth-of-type(6) .snum { transition-delay: .2s } .sbook:nth-of-type(7) .snum { transition-delay: .24s }
    .sbook:nth-of-type(8) .snum { transition-delay: .28s } .sbook:nth-of-type(9) .snum { transition-delay: .32s } .sbook:nth-of-type(10) .snum { transition-delay: .36s }
    .sbook:nth-of-type(11) .snum { transition-delay: .4s } .sbook:nth-of-type(12) .snum { transition-delay: .44s }
    /* no labels on the shelf: the title of the book you point at rides along with the pointer (Cursor.astro);
       a book reached with the keyboard turns the board above the shelf to its title */
    .wpull.quick.go :global(.c) { transition-delay: calc(var(--i) * 14ms); }
    .wall.rv.rv-in.showing .wmore { opacity: 0; transition: opacity .25s ease; }
    /* reader: the pulled-out book opens over the shelf */
    .reader { position: absolute; inset: 0; z-index: 5; display: grid; place-items: center; }
    .reader[hidden] { display: none; }
    .rback { position: absolute; inset: 0; background: rgba(20,12,5,.62); backdrop-filter: blur(5px); animation: fadeIn .35s ease; }
    @keyframes fadeIn { from { opacity: 0; } }
    .reader .pages { position: relative; inset: auto; opacity: 1; pointer-events: auto; display: none; grid-template-columns: 1fr 1fr; width: min(980px, 78vw); height: min(600px, 78vh); perspective: 1800px;
      padding: 6px; border-radius: 8px; background: linear-gradient(90deg, #2a1d12, #3a2817 49%, #1a120a 50%, #3a2817 51%, #2a1d12); box-shadow: 0 50px 80px -30px rgba(0,0,0,.8); }
    .reader .pages.on { display: grid; animation: pull .55s cubic-bezier(.2,.7,.2,1); }
    @keyframes pull { from { opacity: 0; transform: translateY(60px) scale(.92); } }
    .reader .cover { border-radius: 6px 0 0 6px; box-shadow: -1px 1px 0 #e6dcc6, -2px 2px 0 #cfc2a5, -3px 3px 0 #e6dcc6, -4px 4px 0 #c4b697, -5px 5px 0 #e6dcc6, -6px 6px 0 #b9aa8a; }
    .reader .story { border-radius: 0 6px 6px 0; transform-origin: left center; transform: rotateY(-100deg);
      box-shadow: 1px 1px 0 #e6dcc6, 2px 2px 0 #cfc2a5, 3px 3px 0 #e6dcc6, 4px 4px 0 #c4b697, 5px 5px 0 #e6dcc6, 6px 6px 0 #b9aa8a; }
    .reader .pages.on .story { transform: none; transition: transform .9s cubic-bezier(.2,.7,.2,1) .3s; }
    .pages.playing .clip { opacity: 1; }
    /* the old flat shelf is replaced by the scene on desktop */

  /* phone: bigger books you pan sideways, the centred book's title in a caption bar */
  .cap-bar { display: none; }
  @media (max-width: 899px), (hover: none) {
    .wall { display: none; }
    .cap-bar { display: grid; position: absolute; left: 12px; right: 12px; bottom: calc(14px + env(safe-area-inset-bottom, 0px)); z-index: 3; gap: 8px; justify-items: center; text-align: center;
      padding: 14px 14px 12px; border-radius: 18px; background: rgba(16,10,4,.78); backdrop-filter: blur(8px); box-shadow: 0 0 0 1px rgba(234,211,154,.25);
      opacity: 0; transform: translateY(10px); transition: opacity .6s ease .3s, transform .6s ease .3s; }
    .scene.live .cap-bar { opacity: 1; transform: none; }
    .cb-eye { display: block; font: 800 11px/1 var(--f-body); letter-spacing: .22em; text-transform: uppercase; color: var(--gold-hi); }
    .cb-eye.kicker::before { margin-bottom: 10px; }
    .cb-title { margin: 0; font: 800 19px/1.18 var(--f-head); letter-spacing: -0.01em; text-transform: uppercase; color: #fff; min-height: 1.18em; text-wrap: balance; }
    .cb-row { display: flex; gap: 10px; align-items: center; }
    .cb-open { border: 0; border-radius: 999px; padding: 10px 18px; background: var(--grad-gold, var(--gold)); color: #1a1408; font: 700 14px var(--f-body); }
    .sbook.hov .slice, .sbook.hov .slice::before, .sbook.hov .slot { transition-delay: 0s; }
    .reader { place-items: stretch; }
    .reader .pages { width: 100%; height: 100%; grid-template-columns: 1fr; grid-template-rows: 40% 1fr; padding: 0; border-radius: 0; background: #f8f2e4; }
    .reader .cover { border-radius: 0 !important; box-shadow: none !important; aspect-ratio: auto; }
    .reader .story { border-radius: 0; box-shadow: none; overflow-y: auto; padding: 22px 22px calc(28px + env(safe-area-inset-bottom, 0px)); transform-origin: top center; transform: rotateX(-80deg); }
    .reader .shut { display: block; z-index: 2; background: #f8f2e4; }
    .reader .bign { font-size: 44px; }
  }
</style>

<script>
  import { track } from '../lib/ev';
  import { fitFrame, isWide } from '../lib/frame';
  const shelf = document.querySelector<HTMLElement>('.shelf')!;
  const L = JSON.parse(shelf.dataset.labels!);
  const loc = shelf.dataset.locale!;
  const books = [...shelf.querySelectorAll<HTMLElement>('.book')];
  const today = new Date(); today.setHours(0, 0, 0, 0);
  books.forEach((li) => {
    const st = li.querySelector<HTMLElement>('.status')!;
    const d = li.dataset.date;
    if (!d) { st.textContent = L.prod; return; }
    const date = new Date(d + 'T00:00:00');
    if (date <= today) { st.textContent = L.out; st.classList.add('out'); li.classList.add('out'); }
    else st.textContent = `${L.soon} · ${date.toLocaleDateString(loc, { day: 'numeric', month: 'short' })}`;
  });

  // ---- muted preview clip on the open (desktop) / centred (mobile) book
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let modal = false;
  let current: HTMLElement | null = null;
  function preview(li: HTMLElement | null) {
    if (reduce || modal || li === current) return;
    if (current) { current.classList.remove('playing'); current.querySelector('video')?.pause(); }
    current = li;
    const v = li?.querySelector<HTMLVideoElement>('video.clip');
    if (!li || !v) return;
    if (!v.src) v.src = v.dataset.src!;
    v.play().then(() => li.classList.add('playing')).catch(() => {});
  }

  // ---- in-page YouTube player (privacy-enhanced, loads only on click)
  const dlg = document.querySelector<HTMLDialogElement>('dialog.player')!;
  const frame = dlg.querySelector<HTMLElement>('.frame')!;
  const partsBox = dlg.querySelector<HTMLElement>('.pparts')!;
  const showPart = (id: string) => {
    frame.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&playsinline=1" title="Carrie the Swiss" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>`;
    partsBox.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.id === id)));
  };
  shelf.querySelectorAll<HTMLAnchorElement>('a[data-yt]').forEach((a) => {
    a.addEventListener('click', (ev) => {
      if (typeof dlg.showModal !== 'function') return;
      ev.preventDefault();
      track('ep_play', a.dataset.n ?? '');
      const ids = a.dataset.yt!.split(',');
      dlg.querySelector('.ptitle')!.textContent = a.dataset.title!;
      partsBox.innerHTML = ids.length > 1 ? ids.map((id, i) => `<button type="button" data-id="${id}">${i + 1}/${ids.length}</button>`).join('') : '';
      partsBox.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => showPart(b.dataset.id!)));
      showPart(ids[0]);
      if (current) { current.classList.remove('playing'); current.querySelector('video')?.pause(); current = null; }
      modal = true;
      dlg.showModal();
    });
  });
  const shutPlayer = () => { frame.innerHTML = ''; dlg.close(); };
  dlg.querySelector('.pclose')!.addEventListener('click', shutPlayer);
  dlg.addEventListener('click', (e) => { if (e.target === dlg) shutPlayer(); });
  dlg.addEventListener('close', () => {
    frame.innerHTML = '';
    modal = false;
    (document.activeElement as HTMLElement | null)?.blur();
    const open = document.querySelector<HTMLElement>('.reader .pages.on');
    if (open) preview(open);
  });

  const desktop = matchMedia('(min-width: 900px) and (hover: hover)');
  let openBook: (li: HTMLElement) => void = (li) => li.scrollIntoView({ inline: 'start', block: 'nearest', behavior: 'smooth' });
  const film = !reduce;
  if (film) {
    const wide = isWide();
    const sceneWrap = document.querySelector<HTMLElement>('.scene-wrap')!;
    const scene = sceneWrap.querySelector<HTMLElement>('.scene')!;
    const f = scene.querySelector<HTMLElement>('.f1920')!;
    const reader = scene.querySelector<HTMLElement>('.reader')!;
    // the scene lives inside the film's sticky stage, so it can never slide against the film
    const scrub = document.querySelector<HTMLElement>('.scrub')!;
    scrub.querySelector('.stage')!.appendChild(scene);
    scrub.appendChild(sceneWrap); // becomes an anchor at the calm end of the film
    // "#episodes" (nav, hero button, other pages) should land on the shelf scene
    document.getElementById('episodes')!.id = 'episodes-more';
    sceneWrap.id = 'episodes';
    // in the long (house walk) film the section is taller, so pin the anchor in pixels at 55 % of the old film
    if (scrub.classList.contains('with-house')) {
      const st = scrub.querySelector<HTMLElement>('.stage')!;
      const pin = () => { sceneWrap.style.top = `${5.5 * st.clientHeight}px`; };
      pin(); addEventListener('resize', pin);
    }
    if (location.hash === '#episodes') requestAnimationFrame(() => sceneWrap.scrollIntoView());
    // place the 1920x1080 frame exactly like the film (object-fit: cover, centred)
    // phones see the whole shelf (fitFrame): nothing to drag sideways
    const fit = () => {
      const fr = fitFrame(scene.clientWidth, scene.clientHeight);
      f.style.transform = `translate(${fr.left}px, ${fr.top}px) scale(${fr.k})`;
    };
    new ResizeObserver(fit).observe(scene); fit();
    scene.inert = true;   // until the film rests on the shelf: nothing in the scene can be tapped or tabbed into
    // the scene takes over only when it sits exactly where the film's last frame is
    let lastKey = '';
    const watch = () => {
      // keep the framing identical to the film's even if the header or viewport changes
      const key = `${scene.clientWidth}x${scene.clientHeight}x${(document.querySelector('header.top') as HTMLElement | null)?.offsetHeight}`;
      if (key !== lastKey) { lastKey = key; fit(); }
      const w = window as any, q = w.__filmQ ?? 0, live = scene.classList.contains('live');
      // take over when the film rests on its last frame; let go only after a clear scroll back (no flicker)
      const fp = w.__filmP ?? 0;
      const on = (live ? q > 0.975 : q >= 0.999 && w.__filmAtEnd !== false) && fp < 0.6; // film 2 takes over at 60 %
      if (on !== scene.classList.contains('live')) {
        scene.classList.toggle('live', on); scene.inert = !on; if (!on) closeAll();
        scene.querySelector('.cap-bar')!.classList.toggle('rv-in', on);
        scene.querySelector('.wall')!.classList.toggle('rv-in', on);
        if (on) { wallTitle.classList.remove('quick'); flap(wide ? wallTitle : capTitle); } else { wallTitle.classList.remove('go'); boardHome(); }
      }
      requestAnimationFrame(watch);
    };
    const pagesOf = new Map<string, HTMLElement>();
    books.forEach((li) => { const pg = li.querySelector<HTMLElement>('.pages')!; reader.appendChild(pg); pagesOf.set(li.dataset.n!, pg); });
    const sbooks = [...scene.querySelectorAll<HTMLElement>('.sbook')];
    function closeAll() {
      reader.hidden = true;
      pagesOf.forEach((pg) => pg.classList.remove('on'));
      preview(null);
    }
    openBook = (li: HTMLElement) => {
      const pg = pagesOf.get(li.dataset.n!)!;
      track('ep_open', li.dataset.n ?? '');
      closeAll();
      reader.hidden = false;
      pg.classList.add('on');
      setTimeout(() => { preview(pg); pg.querySelector<HTMLElement>('.go, .cover')?.focus({ preventScroll: true }); }, 500);
    };
    const byN = (n: string) => books.find((l) => l.dataset.n === n)!;
    // phone: every book is on screen. A tap picks one (it lifts, its title shows in the caption bar);
    // a second tap on it, or the button, opens it
    const capTitle = scene.querySelector<HTMLElement>('.cb-title')!;
    const wallTitle = scene.querySelector<HTMLElement>('.wpull')!;
    let sel = '';
    const esc = (t: string) => t.replace(/[&<>"]/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' } as Record<string, string>)[m]);
    // a title flips in letter by letter, like a departures board (fx-flap in global.css)
    const flap = (el = capTitle) => { el.classList.remove('go'); void el.offsetWidth; el.classList.add('go'); };
    const select = (n: string) => {
      sel = n;
      sbooks.forEach((b) => b.classList.toggle('hov', b.dataset.n === n));
      const title = sbooks.find((b) => b.dataset.n === n)?.getAttribute('aria-label') ?? n;
      let i = 0;
      capTitle.innerHTML = `<span class="sr-only">${esc(title)}</span><span class="sp" aria-hidden="true">${title.split(/\s+/).filter(Boolean)
        .map((w) => `<span class="w">${[...w].map((ch) => `<span class="c" style="--i:${i++}">${esc(ch)}</span>`).join('')}</span>`).join(' ')}</span>`;
      flap();
    };
    if (!wide) {
      const outs = books.filter((li) => li.classList.contains('out'));
      select((outs[outs.length - 1] ?? books[0]).dataset.n!);   // start on the newest episode
      scene.querySelector('.cb-open')!.addEventListener('click', () => sel && openBook(byN(sel)));
    }
    // keyboard: the board above the shelf turns to the focused book, and back once focus leaves the shelf
    const wallRow = scene.querySelector<HTMLElement>('.wall')!;
    let boardText = '', boardT = 0;
    const boardTo = (text: string, home = false) => {
      clearTimeout(boardT);
      if (boardText === text) return;
      boardText = text;
      let k = 0;
      wallTitle.innerHTML = `<span class="sp" aria-hidden="true">${text.split(/\s+/).filter(Boolean)
        .map((w) => `<span class="w">${[...w].map((ch) => `<span class="c" style="--i:${k++}">${esc(ch)}</span>`).join('')}</span>`).join(' ')}</span>`;
      wallTitle.classList.add('quick'); wallRow.classList.toggle('showing', !home);
      flap(wallTitle);
    };
    const pullText = wallTitle.getAttribute('aria-label') ?? '';
    // leaving the shelf: the board quietly shows its own title again (no flap while nobody looks)
    const boardHome = () => { if (boardText && boardText !== pullText) { boardTo(pullText, true); wallTitle.classList.remove('go', 'quick'); } };
    sbooks.forEach((b) => {
      if (wide) {
        b.addEventListener('focus', () => { if (b.matches(':focus-visible')) boardTo(b.getAttribute('aria-label') ?? ''); });
        b.addEventListener('blur', () => { boardT = window.setTimeout(() => boardTo(pullText, true), 300); });
      }
      b.addEventListener('click', () => {
        if (wide || b.dataset.n === sel) return openBook(byN(b.dataset.n!));
        select(b.dataset.n!);
      });
    });
    reader.querySelector('.rback')!.addEventListener('click', closeAll);
    reader.querySelectorAll('.shut').forEach((x) => x.addEventListener('click', closeAll));
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal) closeAll(); });
    // use the exact frame rendered from the film once it is ready
    const useFrame = (url: string) => { scene.style.setProperty('--shelf-img', `url(${url})`); scene.querySelector<HTMLImageElement>('.sbg')!.src = url; };
    if ((window as any).__shelfFrame) useFrame((window as any).__shelfFrame);
    window.addEventListener('shelf-frame', (e) => useFrame((e as CustomEvent).detail));
    requestAnimationFrame(watch);
    // open requests from elsewhere wait until the scene is in place
    window.addEventListener('open-book', (e) => {
      const li = byN((e as CustomEvent).detail);
      const t0 = performance.now();
      const wait = () => { if (scene.classList.contains('live')) openBook(li); else if (performance.now() - t0 < 4000) requestAnimationFrame(wait); };
      requestAnimationFrame(wait);
    });
  }
  if (!film) {
    const io = new IntersectionObserver((ents) => {
      const best = ents.filter((e) => e.isIntersecting && e.intersectionRatio > 0.7).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (best) preview(best.target as HTMLElement);
    }, { root: shelf, threshold: [0.7, 0.9] });
    books.forEach((li) => io.observe(li));
  }
  if (!film) window.addEventListener('open-book', (e) => {
    const li = books.find((b) => b.dataset.n === (e as CustomEvent).detail);
    if (li) setTimeout(() => openBook(li), 300);
  });
</script>
