---
// "Follow me": the latest shorts from the YouTube channel (via /api/latest, thumbnails proxied) + channel links.
import { type Locale, t } from '../i18n';
import { EPISODES, INSTAGRAM, YOUTUBE } from '../data/episodes';
interface Props { locale: Locale }
const { locale } = Astro.props;
const f = (t(locale) as any).follow;
const topics = Object.entries((t(locale) as any).topics as Record<string, string>).filter(([k]) => k !== 'intro').map(([, v]) => v);
// fallback while the feed loads (or if it fails): the published season-one episodes
const fallback = EPISODES.filter((e) => e.yt).slice(-8).reverse().map((e) => ({ id: e.yt![0], title: `${e.n} · ${e.title}` }));
---
<section class="block follow" id="follow">
  <div class="marq" aria-hidden="true"><div class="mq-track">{[0, 1].map(() => (
    <span class="mq-run">{topics.map((w) => <Fragment><span class="mq-w">{w}</span><span class="mq-s">✦</span></Fragment>)}</span>
  ))}</div></div>
  <div class="wrap">
    <div class="head" data-reveal>
      <p class="eyebrow kicker">{f.eyebrow}</p>
      <h2 class="fx-wipe fx-fill">{f.title}</h2>
      <p class="muted">{f.intro}</p>
      <form class="notify" novalidate data-lang={locale} data-msg={JSON.stringify({ ok: f.ok, err: f.err, invalid: f.invalid, off: f.off, done: f.done })}>
        <p class="nl-title">{f.nl_title}</p>
        <div class="nl-row">
          <label class="sr-only" for="nl-email">{f.nl_placeholder}</label>
          <input id="nl-email" type="email" name="email" autocomplete="email" placeholder={f.nl_placeholder} required />
          <button type="submit">{f.nl_button}</button>
        </div>
        <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label class="consent"><input type="checkbox" name="consent" required /> <span>{f.nl_consent}</span></label>
        <p class="nl-msg" aria-live="polite"></p>
      </form>
      <div class="links">
        <a class="pill-cta" href={`${YOUTUBE}?sub_confirmation=1`} target="_blank" rel="noopener">{f.yt}</a>
        <a class="ghost" href={INSTAGRAM} target="_blank" rel="noopener">{f.ig}</a>
      </div>
    </div>
  </div>
  <ol class="row" data-play={f.play}>
    {fallback.map((v) => (
      <li><a class="short" href={`https://www.youtube.com/shorts/${v.id}`} target="_blank" rel="noopener" data-yt={v.id} data-title={v.title}>
        <img src={`/api/thumb/${v.id}.jpg`} alt="" loading="lazy" />
        <span class="pl" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z"/></svg></span>
        <span class="tt">{v.title}</span>
      </a></li>
    ))}
  </ol>
</section>

<style>
  .follow { background: radial-gradient(60% 50% at 10% 0%, rgba(201,163,91,.12), transparent 70%), var(--ink); overflow: hidden; }
  /* the series' topics run past in big caps, every other one filled; scrolling pushes them faster, up turns them round */
  .marq { overflow: hidden; margin: 0 0 clamp(28px, 4vw, 56px); padding-block: 4px; }
  .mq-track { display: flex; width: max-content; will-change: transform; }
  .mq-run { display: flex; align-items: center; gap: .42em; padding-right: .42em; font: 800 clamp(46px, 8.4vw, 128px)/1.08 var(--f-head); text-transform: uppercase; letter-spacing: -.012em; white-space: nowrap; }
  .mq-w { color: transparent; -webkit-text-stroke: 1.4px rgba(234,211,154,.5); }
  .mq-w:nth-child(4n+1) { color: rgba(234,211,154,.92); -webkit-text-stroke: 0; }
  .mq-s { font-size: .34em; color: var(--gold); opacity: .8; }
  .head { display: grid; gap: 14px; max-width: 46em; margin-bottom: 34px; }
  .head h2 { font-size: clamp(28px, 3.9vw, 50px); color: #fff; }
  .notify { display: grid; gap: 10px; margin-top: 8px; padding: 18px; border-radius: 18px; background: rgba(251,248,241,.04); box-shadow: 0 0 0 1px rgba(234,211,154,.2); max-width: 560px; }
  .nl-title { margin: 0; font: 800 15px/1.25 var(--f-head); letter-spacing: .02em; text-transform: uppercase; color: #fff; }
  .nl-row { display: flex; gap: 10px; }
  .nl-row input { flex: 1; min-width: 0; height: 50px; border-radius: 999px; border: 1px solid rgba(234,211,154,.35); background: rgba(13,12,10,.6); color: var(--ivory); padding: 0 18px; font: 500 16px var(--f-body); }
  .nl-row input:focus { outline: none; border-color: var(--gold); }
  .nl-row button { flex: none; height: 50px; padding: 0 20px; border: 0; border-radius: 999px; background: var(--grad-gold, var(--gold)); color: #1a1408; font: 700 15px var(--f-body); cursor: pointer; }
  .nl-row button:disabled { opacity: .5; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .consent { display: flex; gap: 10px; align-items: flex-start; font-size: 13px; line-height: 1.45; color: var(--muted-dark); cursor: pointer; }
  .consent input { margin-top: 2px; accent-color: var(--gold); width: 16px; height: 16px; flex: none; }
  .nl-msg { margin: 0; font-size: 14px; color: var(--gold-hi); min-height: 1em; }
  .nl-msg.err { color: #e7a07a; }
  @media (max-width: 520px) { .nl-row { flex-direction: column; } .nl-row input { flex: none; } }   /* stacked: the field keeps its 50 px */
  .links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  .ghost { display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px; border-radius: 999px; border: 1px solid rgba(234,211,154,.45); color: var(--ivory); text-decoration: none; font-weight: 600; }
  .ghost:hover { border-color: var(--gold); color: var(--gold-hi); }
  .row { list-style: none; margin: 0; padding: 0 var(--gutter-r) 10px var(--gutter); display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: thin; scrollbar-color: rgba(201,163,91,.4) transparent; }
  .row li { flex: 0 0 clamp(170px, 18vw, 240px); scroll-snap-align: start; }
  .short { position: relative; display: block; aspect-ratio: 9 / 16; border-radius: 16px; overflow: hidden; background: #1a140c; box-shadow: 0 0 0 1px rgba(234,211,154,.18); text-decoration: none; }
  .short img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
  .short:hover img { transform: scale(1.05); }
  .short::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(13,12,10,.9) 0%, rgba(13,12,10,0) 45%); pointer-events: none; }
  .pl { position: absolute; z-index: 1; left: 50%; top: 44%; width: 56px; height: 56px; margin: -28px 0 0 -28px; border-radius: 50%; display: grid; place-items: center;
    background: rgba(13,12,10,.45); border: 1.5px solid rgba(234,211,154,.85); backdrop-filter: blur(6px); transition: transform .3s, background .3s; }
  .pl svg { width: 22px; height: 22px; margin-left: 3px; fill: var(--gold-hi); }
  .short:hover .pl { transform: scale(1.1); background: var(--gold); }
  .short:hover .pl svg { fill: #1a1408; }
  .tt { position: absolute; z-index: 1; left: 12px; right: 12px; bottom: 12px; font: 600 14px/1.3 var(--f-body); color: var(--ivory); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>

<script>
  // the marquee: always drifting left, faster while the page scrolls, and the other way round when you scroll up
  const track = document.querySelector<HTMLElement>('.follow .mq-track');
  if (track && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const run = track.firstElementChild as HTMLElement;
    let x = 0, v = 0, dir = 1, last = scrollY, on = false;
    const tick = () => {
      const dy = scrollY - last; last = scrollY;
      if (dy) dir = dy > 0 ? 1 : -1;
      v += (Math.min(40, Math.abs(dy)) * 0.35 - v) * 0.08;
      x -= dir * (0.55 + v);
      const w = run.offsetWidth;
      if (x <= -w) x += w; else if (x > 0) x -= w;
      track.style.transform = `translate3d(${x.toFixed(1)}px, 0, 0)`;
      if (on) requestAnimationFrame(tick);
    };
    new IntersectionObserver(([e]) => { const was = on; on = e.isIntersecting; if (on && !was) { last = scrollY; requestAnimationFrame(tick); } }).observe(track);
  }
  const form = document.querySelector<HTMLFormElement>('.follow .notify');
  if (form) {
    const M = JSON.parse(form.dataset.msg!);
    const msg = form.querySelector<HTMLElement>('.nl-msg')!;
    const btn = form.querySelector<HTMLButtonElement>('button')!;
    const say = (t: string, err = false) => { msg.textContent = t; msg.classList.toggle('err', err); };
    if (new URLSearchParams(location.search).has('subscribed')) say(M.done);
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
      const consent = (form.elements.namedItem('consent') as HTMLInputElement).checked;
      if (!/^\S+@\S+\.\S+$/.test(email) || !consent) return say(M.invalid, true);
      btn.disabled = true;
      try {
        const r = await fetch('/api/subscribe', { method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email, consent, lang: form.dataset.lang, website: (form.elements.namedItem('website') as HTMLInputElement).value }) });
        if (r.ok) { say(M.ok); form.reset(); } else say(r.status === 503 ? M.off : r.status === 400 ? M.invalid : M.err, true);
      } catch { say(M.err, true); }
      btn.disabled = false;
    });
  }
  const row = document.querySelector<HTMLElement>('.follow .row');
  if (row) {
    const card = (v: { id: string; title: string }) => {
      const li = document.createElement('li');
      li.innerHTML = `<a class="short" href="https://www.youtube.com/shorts/${v.id}" target="_blank" rel="noopener"><img src="/api/thumb/${v.id}.jpg" alt="" loading="lazy"><span class="pl" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z"/></svg></span><span class="tt"></span></a>`;
      const a = li.querySelector('a')!; a.dataset.yt = v.id; a.dataset.title = v.title;
      li.querySelector('.tt')!.textContent = v.title;
      // keep Astro's scoped styles on dynamically created nodes
      const scope = [...row.attributes].find((x) => x.name.startsWith('data-astro-cid'));
      if (scope) li.querySelectorAll('*').forEach((n) => n.setAttribute(scope.name, '')), li.setAttribute(scope.name, '');
      return li;
    };
    fetch('/api/latest').then((r) => r.ok ? r.json() : null).then((d) => {
      if (!d?.items?.length) return;
      row.replaceChildren(...d.items.slice(0, 10).map(card));
    }).catch(() => {});
    // play in the site's own player (privacy-enhanced, only on click)
    row.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-yt]');
      const dlg = document.querySelector<HTMLDialogElement>('dialog.player');
      if (!a || !dlg || typeof dlg.showModal !== 'function') return;
      e.preventDefault();
      dlg.querySelector('.ptitle')!.textContent = a.dataset.title || '';
      dlg.querySelector('.pparts')!.innerHTML = '';
      dlg.querySelector('.frame')!.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${a.dataset.yt}?autoplay=1&rel=0&playsinline=1" title="Carrie the Swiss" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>`;
      dlg.showModal();
    });
  }
</script>
