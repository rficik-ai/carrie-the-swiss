---
// Splits a title into words (and letters) so each scene can bring its text in its own way (see "text that arrives"
// in global.css). The heading keeps its plain text as aria-label; the pieces are hidden from screen readers.
interface Props { text: string; by?: 'char' | 'word' }
const { text, by = 'char' } = Astro.props;
const words = text.split(/\s+/).filter(Boolean);
const mid = (words.length - 1) / 2;
let ci = 0;
const rnd = (i: number) => ((((i + 1) * 2654435761) >>> 0) % 997) / 997;   // a stable "random" 0…1 per letter (embers light up out of order)
---
<span class="sp" aria-hidden="true" style={`--n:${by === 'char' ? words.join('').length : words.length}`}>{words.map((w, wi) => (
  <Fragment>{wi > 0 && ' '}<span class="w" style={`--wi:${wi};--a:${Math.abs(wi - mid).toFixed(1)};--rot:${wi % 2 ? 9 : -9}deg`}>{by === 'char' ? [...w].map((ch) => { const i = ci++; return <span class="c" style={`--i:${i};--r:${rnd(i).toFixed(2)}`}>{ch}</span>; }) : w}</span></Fragment>
))}</span>
