---
// House walk, last stop: the front door at night. The collar on the hook is the (future) shop;
// the newsletter, the latest episodes and the footer then scroll up over the same scene.
import { type Locale, t } from '../i18n';
import { INSTAGRAM } from '../data/episodes';
import TapIcon from './TapIcon.astro';
import Split from './Split.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const s = t(locale) as any, h = s.house;
---
<div class="hstop dostop" data-stop="door" aria-label={h.door_title}>
  <div class="layer">
    <button type="button" class="hook" style="left:840px;top:150px;width:330px;height:430px" aria-label={s.shop.title} data-cur={s.nav.shop}></button>
  </div>
  <div class="cap rv">
    <p class="eyebrow kicker rf" style="--fd:.15s"><span class="no">08</span>{h.door_eyebrow}</p>
    <h2 class="fx-night" aria-label={h.door_title}><Split two text={h.door_title} by="word" /></h2>
    <p class="say rf" style="--fd:1.5s">{h.door_say}</p>
    <p class="hint tapchip rf" style="--fd:1.9s"><TapIcon /><span><span class="h-wide">{h.door_hint_wide}</span><span class="h-tap">{h.door_hint_tap}</span></span></p>
  </div>
  <div class="tag" hidden>
    <button type="button" class="x" aria-label={h.close}>×</button>
    <p class="cap-k">{s.shop.eyebrow}</p>
    <p class="tt statement sm">{s.shop.title}</p>
    <p class="tx">{s.shop.text}</p>
    <a class="pill-cta" href={INSTAGRAM} target="_blank" rel="noopener">{s.shop.cta}</a>
  </div>
</div>

<style>
  .hstop { position: absolute; inset: 0; z-index: 6; opacity: 0; pointer-events: none; transition: opacity .35s ease; }
  .hstop.live { opacity: 1; pointer-events: auto; }
  .layer { position: absolute; left: 0; top: 0; width: 1920px; height: 1080px; transform-origin: 0 0; }
  .hook { all: unset; position: absolute; cursor: pointer; border-radius: 30px; }
  .hook:focus-visible { outline: 3px solid var(--gold-hi); }
  .cap { position: absolute; left: var(--gutter); top: 50%; transform: translateY(-40%); max-width: min(520px, 40vw); display: grid; gap: 10px; justify-items: start; pointer-events: none; transition: opacity .4s; opacity: var(--fade, 1); }
  .cap h2 { font-size: clamp(32px, 3.9vw, 58px); color: #fff; text-shadow: 0 2px 24px rgba(0,0,0,.35); }
  .cap .say { margin: 0; font: 500 clamp(16px, 1.25vw, 19px)/1.5 var(--f-body); color: rgba(244,238,226,.88); }
  .cap .hint { margin: 6px 0 0; }
  .h-tap { display: none; }
  .dostop.tagged .cap { opacity: 0; }
  .tag { position: absolute; z-index: 3; left: var(--tx, 50%); top: var(--ty, 50%); width: min(420px, 80vw); padding: 0; box-sizing: border-box; display: grid; gap: 8px; justify-items: start;
    color: var(--ivory); animation: tagIn .45s cubic-bezier(.2,.7,.2,1); }
  /* no card: the words lie on the hallway, the night deepens a little on the left while the shop is open */
  .dostop.tagged::after { content: ''; position: absolute; inset: 0; z-index: 2; pointer-events: none; background: linear-gradient(90deg, rgba(8,5,2,.8) 0%, rgba(8,5,2,.5) 34%, rgba(8,5,2,0) 60%); }
  .tag[hidden] { display: none; }
  @keyframes tagIn { from { opacity: 0; transform: translateY(14px) rotate(-1.5deg); } }
  .tag .cap-k { margin: 0; color: var(--gold-hi); }
  .tt { margin: 0; color: #fff; font-size: clamp(34px, 3.6vw, 56px); }
  .tx { margin: 0 0 6px; font-size: 15px; line-height: 1.55; color: rgba(244,238,226,.8); }
  .x { all: unset; position: absolute; top: 8px; right: 8px; width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; cursor: pointer; font-size: 22px; color: var(--muted-dark); }
  @media (max-width: 899px), (hover: none) {
    .h-wide { display: none; } .h-tap { display: inline; }
    .cap { left: 0; right: 0; top: auto; bottom: 0; transform: none; max-width: none; padding: 80px 18px calc(24px + env(safe-area-inset-bottom, 0px)); justify-items: center; text-align: center; --ko: center; background: linear-gradient(0deg, rgba(13,9,4,.9) 0%, rgba(13,9,4,.6) 60%, rgba(13,9,4,0) 100%); }
    .cap .kicker::before { margin-inline: auto; }
    .cap h2 { font-size: 34px; } .cap .say { font-size: 15px; }
    .tag { left: 50% !important; top: auto !important; bottom: 20px; transform: translateX(-50%); }
  }
</style>

<script>
  import { mountStop } from '../lib/stop';
  import { isWide } from '../lib/frame';
  const el = document.querySelector<HTMLElement>('.dostop');
  if (el) {
    const tag = el.querySelector<HTMLElement>('.tag')!;
    let fr = { k: 1, left: 0, top: 0 };
    const place = () => {
      // the shop tag hangs to the left of the hooks
      if (!isWide()) return;
      const x = Math.max(24, innerWidth * 0.04), y = fr.top + 170 * fr.k;
      tag.style.setProperty('--tx', `${Math.max(16, x)}px`); tag.style.setProperty('--ty', `${Math.max(80, y)}px`);
    };
    const set = (open: boolean) => { tag.hidden = !open; el.classList.toggle('tagged', open); if (open) place(); };
    el.querySelector('.hook')!.addEventListener('click', () => set(tag.hidden));
    tag.querySelector('.x')!.addEventListener('click', () => set(false));
    // the caption makes way when the last part of the page (episodes, e-mail, footer) slides up over the scene
    const cap = el.querySelector<HTMLElement>('.cap')!;
    const W_ = window as any;
    import('../data/house').then(({ HOUSE }) => {
      const loop = () => {
        const y = W_.__houseY ?? 0, end = HOUSE.timeline.total;
        cap.style.setProperty('--fade', String(Math.max(0, Math.min(1, 1 - (y - end + 30) / 40))));
        requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
    });
    mountStop('door', el, { onFrame: (f) => { fr = f; place(); }, onLive: (on) => { if (!on) set(false); } });
  }
</script>
