---
import { type Locale, t } from '../i18n';
import QuizPanel from './QuizPanel.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const q = (t(locale) as any).quiz;
const questions = [1, 2, 3, 4, 5].map((i) => ({ text: q[`q${i}`], opts: [q[`q${i}a`], q[`q${i}b`], q[`q${i}c`]] }));
const results = [1, 2, 3].map((i) => ({ title: q[`r${i}_title`], text: q[`r${i}_text`] }));
---
<section class="light quiz" id="quiz">
  <div class="wrap grid">
    <div class="portrait" data-reveal>
      <img src="/assets/img/carrie-porch.jpg" alt="Carrie" loading="lazy" />
      <div class="bubble" aria-live="polite">
        <span class="who">{q.eyebrow}</span>
        <p class="say">{q.title}</p>
      </div>
    </div>

    <QuizPanel locale={locale} />
  </div>
</section>

<style>
  .quiz { position: relative; overflow: hidden; padding-block: clamp(80px, 10vw, 140px); background: radial-gradient(60% 60% at 0% 0%, rgba(201,163,91,.14), transparent 60%), var(--paper); }
  .grid { display: grid; gap: clamp(32px, 5vw, 72px); align-items: center; }
  @media (min-width: 960px) { .grid { grid-template-columns: .9fr 1.1fr; } }
  .portrait { position: relative; aspect-ratio: 4 / 5; border-radius: 22px; overflow: hidden; box-shadow: 0 40px 80px -40px rgba(60,40,10,.6); }
  .portrait img { width: 100%; height: 100%; object-fit: cover; }
  .bubble { position: absolute; left: 22px; right: 22px; top: 22px; padding: 18px 20px; border-radius: 18px 18px 18px 4px; background: rgba(251,248,241,.94); backdrop-filter: blur(6px); box-shadow: 0 14px 30px -14px rgba(0,0,0,.5); transition: transform .4s cubic-bezier(.2,.7,.2,1); }
  .bubble.bump { animation: bump .45s cubic-bezier(.2,.7,.2,1); }
  @keyframes bump { 0% { transform: scale(.94); } 60% { transform: scale(1.03); } 100% { transform: none; } }
  .who { font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--gold-deep); }
  .say { margin: 6px 0 0; font: 600 clamp(18px, 1.7vw, 22px)/1.3 var(--f-display); color: #1c1914; }
</style>
