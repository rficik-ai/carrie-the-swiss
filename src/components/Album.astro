---
// "My life so far": a photo album with real photos and redacted real documents.
// Desktop: an open book, pages turn with a 3D leaf. Phone: one page, swipe sideways.
import { type Locale, t } from '../i18n';
import { ALBUM } from '../data/album';
interface Props { locale: Locale }
const { locale } = Astro.props;
const a = (t(locale) as any).album;
const tilt = [-3, 2.5, -1.5, 3.5];
const href = (h: string) => (h.startsWith('#') ? `/${locale}/${h}` : `/${locale}/${h}`);
---
<section class="block album" id="album">
  <div class="wrap">
    <div class="head" data-reveal>
      <p class="eyebrow">{a.eyebrow}</p>
      <h2>{a.title}</h2>
      <p class="muted">{a.intro}</p>
    </div>
  </div>
  <div class="stage-a" data-reveal>
    <div class="book" data-n={ALBUM.length}>
      {ALBUM.map((c, i) => (
        <article class:list={['spread', { on: i === 0 }]} data-i={i} aria-hidden={i === 0 ? undefined : 'true'}>
          <div class="pg left">
            <div class:list={['pics', `n${c.pics.length}`]}>
              {c.pics.map((p, j) => (
                <button type="button" class:list={['pic', p.kind]} style={`--r:${tilt[(i + j) % 4]}deg;--ar:${p.w}/${p.h}`} data-full={p.src} aria-label={a.zoom}>
                  <img src={p.src} alt="" loading="lazy" width={p.w} height={p.h} />
                  <span class="tape" aria-hidden="true"></span>
                </button>
              ))}
              {c.stamp && <div class="stamp" aria-hidden="true">{c.stamp.map((s) => <span>{s}</span>)}</div>}
            </div>
          </div>
          <div class="pg right">
            {c.date && <p class="date">{c.date}</p>}
            <h3>{a[`${c.id}_t`]}</h3>
            <p class="txt">{a[`${c.id}_x`]}</p>
            {c.link && <a class="lnk" href={href(c.link.href)} data-open-book={c.id === 'c9' ? '11' : undefined}>{a[c.link.key]} →</a>}
            <span class="folio">{i + 1} / {ALBUM.length}</span>
          </div>
        </article>
      ))}
      <div class="leaf" aria-hidden="true"><div class="lf front"></div><div class="lf back"></div></div>
    </div>
    <button type="button" class="turn prev" aria-label={a.prev} disabled>‹</button>
    <button type="button" class="turn next" aria-label={a.next}>›</button>
    <div class="dots" aria-hidden="true">{ALBUM.map((_, i) => <i class:list={{ on: i === 0 }}></i>)}</div>
  </div>
  <dialog class="lightbox" aria-label={a.zoom}><img alt="" /><button type="button" class="lbx" aria-label={a.close}>✕</button></dialog>
</section>

<style>
  .album { position: relative; overflow: hidden; background:
    radial-gradient(70% 60% at 50% 30%, rgba(201,163,91,.12), transparent 70%), var(--ink); }
  .head { display: grid; gap: 14px; max-width: 46em; margin: 0 auto 40px; text-align: center; justify-items: center; }
  .head h2 { font-size: clamp(34px, 4.6vw, 62px); }
  .stage-a { position: relative; max-width: 1180px; margin: 0 auto; padding: 0 64px; }
  .book { position: relative; aspect-ratio: 16 / 10; perspective: 2600px; border-radius: 10px;
    background: linear-gradient(90deg, #3a2414, #5a3920 3%, #4a2e19 50%, #5a3920 97%, #3a2414); padding: 14px; box-shadow: 0 50px 90px -40px rgba(0,0,0,.9), inset 0 0 0 1px rgba(255,220,170,.12); }
  .spread { position: absolute; inset: 14px; display: grid; grid-template-columns: 1fr 1fr; visibility: hidden; }
  .spread.on { visibility: visible; }
  .pg { position: relative; overflow: hidden; background:
      radial-gradient(120% 90% at 50% 40%, #fbf5e7, #f1e6cd 80%, #e6d6b4); color: #1c1914; }
  .pg.left { border-radius: 6px 0 0 6px; box-shadow: inset -26px 0 30px -20px rgba(80,50,20,.45); }
  .pg.right { border-radius: 0 6px 6px 0; box-shadow: inset 26px 0 30px -20px rgba(80,50,20,.45); padding: clamp(24px, 4vw, 54px) clamp(22px, 3.6vw, 50px); display: flex; flex-direction: column; gap: 14px; }
  .date { margin: 0; font: italic 600 clamp(18px, 1.6vw, 22px) var(--f-display); color: var(--gold-deep); }
  .pg h3 { margin: 0; font: 600 clamp(24px, 2.4vw, 34px)/1.12 var(--f-display); }
  .txt { margin: 0; font-size: clamp(15px, 1.15vw, 17px); line-height: 1.6; color: #3b342a; }
  .lnk { margin-top: auto; align-self: flex-start; font-weight: 700; color: var(--gold-deep); text-decoration: none; border-bottom: 1px solid currentColor; }
  .folio { position: absolute; right: 22px; bottom: 16px; font: italic 13px var(--f-display); color: #9a8664; }
  /* photos and papers pasted on the left page */
  .pics { position: absolute; inset: 6%; display: grid; place-items: center; gap: 4%; }
  .pics.n2 { grid-template-columns: 1fr 1fr; } .pics.n3 { grid-template-columns: 1fr 1fr 1fr; } .pics.n4 { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; }
  .pic { all: unset; position: relative; cursor: zoom-in; max-width: 100%; max-height: 100%; aspect-ratio: var(--ar); width: 100%; transform: rotate(var(--r)); transition: transform .35s cubic-bezier(.2,.7,.2,1); }
  .pics.n1 .pic { width: auto; height: 100%; }
  .pics.n4 { grid-template-columns: repeat(3, 1fr); grid-template-rows: 1.15fr 1fr; }
  .pics.n4 > .pic:first-child { grid-column: 1 / -1; width: auto; height: 100%; }
  .pics.n4 > .pic:not(:first-child) { width: 100%; height: auto; }
  .pic img { width: 100%; height: 100%; object-fit: cover; display: block; box-shadow: 0 10px 20px -8px rgba(60,35,10,.55); }
  .pic.photo img { border: 8px solid #fffdf7; border-bottom-width: 26px; box-sizing: border-box; }
  .pic.doc img { object-fit: contain; background: #fff; }
  .pic:hover, .pic:focus-visible { transform: rotate(0deg) scale(1.04); z-index: 2; outline: none; }
  .tape { position: absolute; left: 50%; top: -10px; width: 74px; height: 22px; transform: translateX(-50%) rotate(-4deg); background: rgba(240,226,190,.75); box-shadow: 0 1px 2px rgba(0,0,0,.15); }
  .stamp { width: min(64%, 300px); aspect-ratio: 1; border-radius: 50%; display: grid; place-content: center; gap: 2px; text-align: center; transform: rotate(-12deg);
    border: 4px double rgba(160,60,30,.75); color: rgba(160,60,30,.8); font: 700 clamp(18px, 2.2vw, 30px)/1.1 var(--f-display); letter-spacing: .04em; }
  .stamp span:first-child { font-size: 1.5em; }
  /* stamp pressed over a photo */
  .pic ~ .stamp { position: absolute; right: 0; bottom: 2%; width: 40%; z-index: 3; font-size: clamp(13px, 1.4vw, 20px); background: rgba(251,246,234,.9); color: rgba(150,50,22,.95); border-color: rgba(150,50,22,.85); box-shadow: 0 6px 14px -6px rgba(60,35,10,.5); pointer-events: none; }
  /* the turning leaf */
  .leaf { position: absolute; top: 14px; bottom: 14px; left: 50%; width: calc(50% - 14px); transform-origin: left center; transform-style: preserve-3d; pointer-events: none; display: none; z-index: 5; }
  .leaf.go { display: block; }
  .lf { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; overflow: hidden; }
  .lf.back { transform: rotateY(180deg); }
  .lf > .pg { position: absolute; inset: 0; }
  .turn { position: absolute; top: 50%; transform: translateY(-50%); width: 48px; height: 72px; border-radius: 14px; border: 0; background: rgba(251,248,241,.06); box-shadow: 0 0 0 1px rgba(234,211,154,.3);
    color: var(--gold-hi); font: 400 38px/1 var(--f-display); cursor: pointer; transition: background .25s; }
  .turn:hover { background: rgba(201,163,91,.2); }
  .turn:disabled { opacity: .25; cursor: default; }
  .turn.prev { left: 0; } .turn.next { right: 0; }
  .dots { display: flex; justify-content: center; gap: 8px; margin-top: 22px; }
  .dots i { width: 8px; height: 8px; border-radius: 50%; background: rgba(234,211,154,.25); transition: background .3s, transform .3s; }
  .dots i.on { background: var(--gold); transform: scale(1.3); }
  .lightbox { border: 0; padding: 0; background: transparent; max-width: 96vw; max-height: 94vh; }
  .lightbox::backdrop { background: rgba(13,12,10,.9); backdrop-filter: blur(4px); }
  .lightbox img { display: block; max-width: 96vw; max-height: 94vh; object-fit: contain; border-radius: 6px; }
  .lbx { position: fixed; top: 16px; right: 16px; width: 44px; height: 44px; border-radius: 50%; border: 1px solid rgba(234,211,154,.5); background: rgba(13,12,10,.6); color: var(--ivory); font-size: 18px; cursor: pointer; }

  @media (max-width: 860px) {
    .stage-a { padding: 0 var(--gutter-r) 0 var(--gutter); }
    .book { aspect-ratio: auto; height: min(calc(100svh - 120px), 660px); padding: 8px; perspective: 1600px; }
    .spread { inset: 8px; grid-template-columns: 1fr; grid-template-rows: 46% 54%; }
    .pg.left { border-radius: 6px 6px 0 0; box-shadow: inset 0 -20px 26px -20px rgba(80,50,20,.45); }
    .pg.right { border-radius: 0 0 6px 6px; box-shadow: inset 0 20px 26px -20px rgba(80,50,20,.45); padding: 20px 20px 34px; gap: 10px; overflow-y: auto; }
    .pics { inset: 7% 5%; } .pics.n3 .pic { width: 100%; height: auto; }
    .pics.n4 { grid-template-rows: 1.25fr 1fr; gap: 3%; } .pics.n4 > .pic:not(:first-child) { width: auto; height: 100%; }
    .pic.photo img { border-width: 5px; border-bottom-width: 16px; }
    .leaf { left: 8px; right: 8px; top: 8px; bottom: 8px; width: auto; transform-origin: left center; }
    .turn { top: auto; bottom: 18px; transform: none; z-index: 6; width: 42px; height: 42px; border-radius: 50%; font-size: 28px; background: rgba(40,26,12,.78); box-shadow: 0 0 0 1px rgba(234,211,154,.45); }
    .turn.prev { left: calc(var(--gutter) + 16px); } .turn.next { right: calc(var(--gutter-r) + 16px); }
    .turn:disabled { opacity: 0; }
    .pg.right { padding-bottom: 70px; }
    .folio { right: 50%; transform: translateX(50%); bottom: 30px; }
    .dots { margin-top: 16px; }
    .stamp { width: 46%; }
  }
  @media (prefers-reduced-motion: reduce) { .pic { transition: none; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.album');
  if (root) {
    const book = root.querySelector<HTMLElement>('.book')!;
    const spreads = [...book.querySelectorAll<HTMLElement>('.spread')];
    const leaf = book.querySelector<HTMLElement>('.leaf')!;
    const front = leaf.querySelector<HTMLElement>('.front')!, back = leaf.querySelector<HTMLElement>('.back')!;
    const prev = root.querySelector<HTMLButtonElement>('.turn.prev')!, next = root.querySelector<HTMLButtonElement>('.turn.next')!;
    const dots = [...root.querySelectorAll<HTMLElement>('.dots i')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const narrow = () => matchMedia('(max-width: 860px)').matches;
    let cur = 0, busy = false;
    const show = (i: number) => {
      spreads.forEach((s, k) => { s.classList.toggle('on', k === i); s.toggleAttribute('aria-hidden', k !== i); });
      dots.forEach((d, k) => d.classList.toggle('on', k === i));
      prev.disabled = i === 0; next.disabled = i === spreads.length - 1;
    };
    const clone = (el: Element) => { const c = el.cloneNode(true) as HTMLElement; c.removeAttribute('aria-hidden'); return c; };
    const pg = (sp: HTMLElement, side: 'left' | 'right') => clone(sp.querySelector(`.pg.${side}`)!);
    function go(d: number) {
      const to = cur + d;
      if (busy || to < 0 || to >= spreads.length) return;
      const from = spreads[cur], dest = spreads[to], fwd = d > 0;
      if (reduce) { cur = to; show(cur); return; }
      busy = true;
      const done = (cleanup: () => void) => () => { cleanup(); leaf.classList.remove('go'); busy = false; };
      if (!narrow()) {
        // open book: the leaf is the page that turns; underneath, the two pages that stay visible during the turn
        const tmp = document.createElement('article');
        for (const at of from.attributes) if (at.name.startsWith('data-astro-cid')) tmp.setAttribute(at.name, '');
        tmp.className = 'spread on';
        tmp.append(pg(fwd ? from : dest, 'left'), pg(fwd ? dest : from, 'right'));
        front.replaceChildren(pg(fwd ? from : dest, 'right'));
        back.replaceChildren(pg(fwd ? dest : from, 'left'));
        book.insertBefore(tmp, leaf);
        cur = to; show(cur); dest.classList.remove('on');
        leaf.classList.add('go');
        const anim = leaf.animate(fwd ? [{ transform: 'rotateY(0deg)' }, { transform: 'rotateY(-180deg)' }] : [{ transform: 'rotateY(-180deg)' }, { transform: 'rotateY(0deg)' }],
          { duration: 900, easing: 'cubic-bezier(.45,.05,.3,1)' });
        anim.onfinish = done(() => { tmp.remove(); dest.classList.add('on'); });
      } else {
        // phone: forward = the current page flips away; back = the previous page flips in
        const sheet = clone(fwd ? from : dest); sheet.classList.add('on'); sheet.style.inset = '0';
        front.replaceChildren(sheet); back.replaceChildren();
        if (fwd) { cur = to; show(cur); }
        leaf.classList.add('go');
        const anim = leaf.animate(fwd ? [{ transform: 'rotateY(0deg)', opacity: 1 }, { transform: 'rotateY(-95deg)', opacity: .2 }] : [{ transform: 'rotateY(-95deg)', opacity: .2 }, { transform: 'rotateY(0deg)', opacity: 1 }],
          { duration: 560, easing: 'cubic-bezier(.45,.05,.3,1)' });
        anim.onfinish = done(() => { if (!fwd) { cur = to; show(cur); } });
      }
    }
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    root.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') go(1); if (e.key === 'ArrowLeft') go(-1); });
    // swipe
    let sx = 0, sy = 0;
    book.addEventListener('pointerdown', (e) => { sx = e.clientX; sy = e.clientY; });
    book.addEventListener('pointerup', (e) => {
      const dx = e.clientX - sx, dy = e.clientY - sy;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.4) go(dx < 0 ? 1 : -1);
    });
    book.style.touchAction = 'pan-y';
    // lightbox for photos and papers
    const lb = root.querySelector<HTMLDialogElement>('.lightbox')!;
    book.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('.pic');
      if (!b || typeof lb.showModal !== 'function') return;
      lb.querySelector('img')!.src = b.dataset.full!; lb.showModal();
    });
    lb.addEventListener('click', () => lb.close());
  }
</script>
