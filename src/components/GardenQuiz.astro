---
// The garden quiz: ten questions in six areas, a result by area with warnings, the method behind the score,
// and an optional detailed evaluation written by Carrie (AI, /api/quiz).
import type { Locale } from '../i18n';
import { QUESTIONS, DIMS, FLAGS, UI } from '../data/quiz';
interface Props { locale: Locale }
const { locale } = Astro.props;
const L = locale === 'sk' ? 'sk' : 'en';
const u = UI[L];
const data = {
  lang: locale,
  q: QUESTIONS.map((q) => ({ id: q.id, dim: q.dim, t: q.t[L], opts: q.opts.map((o) => ({ p: o.p, flag: o.flag ?? null, t: o.t[L] })) })),
  dims: DIMS.map((d) => ({ id: d.id, t: d.t[L] })),
  flags: Object.fromEntries(Object.entries(FLAGS).map(([k, v]) => [k, v[L]])),
  r: [u.r1, u.r2, u.r3],
};
---
<div class="gq" data-q={JSON.stringify(data)} data-err={u.ai_err} data-wait={u.ai_wait}>
  <section class="step intro">
    <p class="eyebrow">{u.eyebrow}</p>
    <h2>{u.title}</h2>
    <p class="muted">{u.intro}</p>
    <div class="row">
      <button type="button" class="pill-cta start">{u.start} <span aria-hidden="true">→</span></button>
      <button type="button" class="link method-open">{u.method}</button>
    </div>
  </section>

  {QUESTIONS.map((q, i) => (
    <fieldset class="step question" data-i={i} hidden>
      <legend><span class="qn">{u.q} {i + 1} / {QUESTIONS.length}</span><span class="qt">{q.t[L]}</span></legend>
      <div class="opts">
        {q.opts.map((o, v) => (
          <button type="button" class="opt" data-v={v}><span class="mark" aria-hidden="true">{'ABCD'[v]}</span><span>{o.t[L]}</span></button>
        ))}
      </div>
      {i > 0 && <button type="button" class="link back">← {u.back}</button>}
    </fieldset>
  ))}

  <section class="step result" hidden>
    <p class="eyebrow">{u.result}</p>
    <div class="score"><span class="pct">0 %</span><p class="rtitle"></p></div>
    <p class="sub">{u.areas}</p>
    <ul class="bars">{DIMS.map((d) => <li data-dim={d.id}><span class="bl">{d.t[L]}</span><span class="bt"><i></i></span><span class="bv"></span></li>)}</ul>
    <div class="warns" hidden><p class="sub">{u.warn}</p><ul></ul></div>
    <div class="aibox">
      <button type="button" class="ai-go">
        <span class="spark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 2.5l1.9 5.6 5.6 1.9-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.9zM19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9z"/></svg></span>
        <span class="aw"><b>{u.ai}</b><small>{u.ai_sub}</small></span>
        <span class="ar" aria-hidden="true">→</span>
      </button>
      <div class="ai-out" aria-live="polite" hidden></div>
      <p class="ai-note" hidden>{u.ai_note}</p>
    </div>
    <div class="row">
      <a class="link" href={`/${locale}/#episodes`} data-open-book="01">▶ {u.watch}</a>
      <button type="button" class="link method-open">{u.method}</button>
      <button type="button" class="link again">↻ {u.again}</button>
    </div>
  </section>

  <div class="dots" aria-hidden="true">{QUESTIONS.map(() => <i></i>)}</div>

  <div class="method" hidden>
    <button type="button" class="mx" aria-label={u.close}>×</button>
    <p class="eyebrow">{u.method_title}</p>
    <p>{u.method_intro}</p>
    <dl>{DIMS.map((d) => <><dt>{d.t[L]}</dt><dd>{d.m[L]}</dd></>)}</dl>
    <p class="mscore">{u.method_score}</p>
  </div>
</div>

<style>
  .gq { position: relative; display: grid; color: #1c1914; }
  .step { display: grid; gap: 14px; border: 0; margin: 0; padding: 0; min-width: 0; animation: enter .45s cubic-bezier(.2,.7,.2,1); }
  .step[hidden], .method[hidden], .warns[hidden], .ai-out[hidden], .ai-note[hidden] { display: none; }
  @keyframes enter { from { opacity: 0; transform: translateX(20px); } }
  .eyebrow { color: var(--gold-deep, #8a6424); }
  h2 { font-size: clamp(28px, 2.8vw, 42px); color: #1c1914; margin: 0; }
  .muted { margin: 0; color: #5a4a36; font-size: 15.5px; line-height: 1.55; }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; margin-top: 4px; }
  .start, .ai-go { border: 0; cursor: pointer; font-family: var(--f-body); }
  .link { all: unset; cursor: pointer; font: 700 14px var(--f-body); color: #7a5520; border-bottom: 1px solid rgba(122,85,32,.4); text-decoration: none; }
  .link:hover { border-color: currentColor; }
  legend { display: grid; gap: 8px; padding: 0; margin-bottom: 6px; }
  .qn { font-size: 12px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--gold-deep, #8a6424); }
  .qt { font: 600 clamp(20px, 1.9vw, 26px)/1.25 var(--f-display); color: #1c1914; }
  .opts { display: grid; gap: 10px; }
  .opt { display: flex; align-items: center; gap: 14px; width: 100%; text-align: left; padding: 13px 16px; border-radius: 12px; border: 1px solid rgba(138,100,36,.3); background: #fffdf8; color: #1c1914; font: 600 15px var(--f-body); cursor: pointer;
    transition: transform .2s cubic-bezier(.2,.7,.2,1), border-color .2s, box-shadow .2s, background .2s; }
  .opt:hover, .opt:focus-visible { transform: translateX(5px); border-color: var(--gold); box-shadow: 0 10px 22px -16px rgba(138,100,36,.6); outline: none; }
  .opt.picked { background: var(--gold); border-color: var(--gold); }
  .mark { flex: none; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; font: 600 14px var(--f-display); color: var(--gold-deep, #8a6424); border: 1px solid rgba(138,100,36,.45); }
  .opt.picked .mark { background: #1a1408; color: var(--gold-hi); border-color: #1a1408; }
  .back { justify-self: start; font-size: 13px; }
  .dots { display: flex; gap: 6px; margin-top: 18px; }
  .dots i { flex: 1; max-width: 26px; height: 4px; border-radius: 4px; background: rgba(138,100,36,.2); transition: background .3s; }
  .dots i.on { background: var(--gold); }
  .gq.done .dots { display: none; }
  /* result */
  .score { display: flex; align-items: center; gap: 16px; }
  .pct { flex: none; width: 76px; height: 76px; border-radius: 50%; display: grid; place-items: center; font: 700 20px var(--f-display); color: #1c1914;
    background: radial-gradient(closest-side, #fbf7ee 78%, transparent 80% 100%), conic-gradient(var(--gold) calc(var(--v, 0) * 1%), rgba(138,100,36,.18) 0); }
  .rtitle { margin: 0; font: 600 clamp(22px, 2.1vw, 30px)/1.15 var(--f-display); }
  .sub { margin: 6px 0 0; font: 700 11px var(--f-body); letter-spacing: .18em; text-transform: uppercase; color: var(--gold-deep, #8a6424); }
  .bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; }
  .bars li { display: grid; grid-template-columns: 9.5em 1fr 3em; align-items: center; gap: 10px; font-size: 14px; }
  .bt { height: 8px; border-radius: 8px; background: rgba(138,100,36,.15); overflow: hidden; }
  .bt i { display: block; height: 100%; width: 0; border-radius: 8px; background: var(--gold); transition: width .9s cubic-bezier(.2,.7,.2,1); }
  .bars li.low .bt i { background: #c0673a; }
  .bv { text-align: right; font-weight: 700; color: #5a4a36; }
  .warns ul { margin: 6px 0 0; padding-left: 18px; display: grid; gap: 6px; font-size: 14.5px; line-height: 1.45; color: #6b2f14; }
  .aibox { display: grid; gap: 12px; margin-top: 8px; }
  /* the AI evaluation: a proper call to action, not a link */
  .ai-go { all: unset; box-sizing: border-box; position: relative; overflow: hidden; cursor: pointer; display: flex; align-items: center; gap: 14px; width: 100%; padding: 16px 18px; border-radius: 14px;
    background: radial-gradient(120% 140% at 0% 0%, #3a2a14 0%, #17110a 60%); color: var(--ivory); box-shadow: 0 0 0 1px rgba(234,211,154,.45), 0 18px 34px -16px rgba(40,20,0,.8); transition: transform .25s, box-shadow .25s; }
  .ai-go::after { content: ''; position: absolute; inset: 0; background: linear-gradient(105deg, transparent 35%, rgba(255,236,190,.22) 50%, transparent 65%); transform: translateX(-100%); animation: sheen 3.2s ease-in-out infinite 1s; pointer-events: none; }
  @keyframes sheen { 0%, 60% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }
  .ai-go:hover, .ai-go:focus-visible { transform: translateY(-2px); box-shadow: 0 0 0 1px var(--gold-hi), 0 24px 40px -16px rgba(40,20,0,.9); }
  .ai-go:disabled { opacity: .6; cursor: default; transform: none; }
  .ai-go:disabled::after { animation: none; }
  .spark { flex: none; width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; background: var(--grad-gold, var(--gold)); }
  .spark svg { width: 22px; height: 22px; fill: #1a1408; }
  .aw { display: grid; gap: 3px; flex: 1; }
  .aw b { font: 600 clamp(18px, 1.6vw, 21px)/1.15 var(--f-display); color: var(--ivory); }
  .aw small { font-size: 13px; line-height: 1.35; color: rgba(244,238,226,.75); }
  .ar { font-size: 22px; color: var(--gold-hi); }
  .ai-out { padding: 14px 16px; border-radius: 12px; background: rgba(201,163,91,.12); box-shadow: inset 0 0 0 1px rgba(138,100,36,.2); }
  @media (prefers-reduced-motion: reduce) { .ai-go::after { animation: none; } }
  .ai-out { font-size: 15px; line-height: 1.55; color: #2a2016; }
  .ai-out :global(h4) { margin: 12px 0 4px; font: 700 15px var(--f-display); color: #1c1914; }
  .ai-out :global(h4:first-child) { margin-top: 0; }
  .ai-out :global(ul) { margin: 0; padding-left: 18px; display: grid; gap: 4px; }
  .ai-out :global(p) { margin: 0 0 6px; }
  .ai-out :global(.wait) { color: #7a6a52; font-style: italic; animation: blink 1.2s ease-in-out infinite; }
  @keyframes blink { 50% { opacity: .45; } }
  .ai-note { margin: 0; font-size: 12px; color: #7a6a52; }
  /* method */
  .method { position: absolute; inset: -6px; z-index: 3; overflow-y: auto; padding: 22px 22px 18px; border-radius: 6px; background: #fbf7ee; box-shadow: 0 0 0 1px rgba(138,100,36,.2); font-size: 14.5px; line-height: 1.55; color: #3d3226; }
  .method p { margin: 0 0 10px; }
  .method dl { margin: 0 0 10px; display: grid; gap: 4px; }
  .method dt { font: 700 15px var(--f-display); color: #1c1914; margin-top: 8px; }
  .method dd { margin: 0; }
  .mscore { padding: 10px 12px; border-radius: 8px; background: rgba(201,163,91,.15); }
  .mx { all: unset; position: sticky; float: right; top: 0; width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; font-size: 22px; cursor: pointer; color: #5a4220; background: #fbf7ee; box-shadow: inset 0 0 0 1px rgba(120,90,40,.35); }
  @media (max-width: 899px), (hover: none) {
    .opt { padding: 11px 13px; font-size: 14.5px; }
    .bars li { grid-template-columns: 8em 1fr 2.6em; font-size: 13px; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.gq');
  if (root) {
    const D = JSON.parse(root.dataset.q!);
    const steps = [...root.querySelectorAll<HTMLElement>('.question')];
    const intro = root.querySelector<HTMLElement>('.intro')!, result = root.querySelector<HTMLElement>('.result')!;
    const dots = [...root.querySelectorAll<HTMLElement>('.dots i')];
    const method = root.querySelector<HTMLElement>('.method')!;
    const say = document.querySelector<HTMLElement>('.gstop .bubble .say');
    const bubble = document.querySelector<HTMLElement>('.gstop .bubble');
    const scroller = root.closest<HTMLElement>('.qcard');
    const answers: (number | null)[] = D.q.map(() => null);
    const talk = (t: string) => { if (!say || !bubble) return; say.textContent = t; bubble.classList.remove('bump'); void bubble.offsetWidth; bubble.classList.add('bump'); };
    const show = (el: HTMLElement) => {
      [intro, result, ...steps].forEach((s) => (s.hidden = s !== el));
      root.classList.toggle('done', el === result);
      scroller?.classList.toggle('tall', el === result);
      scroller?.scrollTo({ top: 0 });
      const q = el.querySelector<HTMLElement>('.qt'); if (q) talk(q.textContent!);
      el.querySelector<HTMLElement>('.opt, .start, .ai-go')?.focus({ preventScroll: true });
    };
    const compute = () => {
      const per: Record<string, { p: number; m: number }> = {};
      const flags: string[] = [];
      D.q.forEach((q: any, i: number) => {
        const max = Math.max(...q.opts.map((o: any) => o.p));
        per[q.dim] ??= { p: 0, m: 0 }; per[q.dim].m += max;
        const o = q.opts[answers[i] ?? 0]; per[q.dim].p += o.p; if (o.flag) flags.push(o.flag);
      });
      const tot = Object.values(per).reduce((a, b) => ({ p: a.p + b.p, m: a.m + b.m }), { p: 0, m: 0 });
      const pct = Math.round((tot.p / tot.m) * 100);
      const tier = pct < 50 || flags.length >= 2 ? 0 : pct <= 75 || flags.length ? 1 : 2;
      return { per, flags, pct, tier };
    };
    let last: ReturnType<typeof compute> | null = null;
    const finish = () => {
      const r = last = compute();
      result.querySelector('.rtitle')!.textContent = D.r[r.tier];
      const pctEl = result.querySelector<HTMLElement>('.pct')!; pctEl.textContent = `${r.pct} %`; pctEl.style.setProperty('--v', String(r.pct));
      result.querySelectorAll<HTMLElement>('.bars li').forEach((li) => {
        const d = r.per[li.dataset.dim!]; const v = Math.round((d.p / d.m) * 100);
        li.classList.toggle('low', v < 50);
        li.querySelector<HTMLElement>('.bv')!.textContent = `${v} %`;
        requestAnimationFrame(() => (li.querySelector<HTMLElement>('.bt i')!.style.width = `${v}%`));
      });
      const wb = result.querySelector<HTMLElement>('.warns')!, ul = wb.querySelector('ul')!;
      ul.replaceChildren(...r.flags.map((f) => { const li = document.createElement('li'); li.textContent = D.flags[f]; return li; }));
      wb.hidden = !r.flags.length;
      const out = result.querySelector<HTMLElement>('.ai-out')!; out.hidden = true; out.textContent = '';
      result.querySelector<HTMLElement>('.ai-note')!.hidden = true;
      result.querySelector<HTMLButtonElement>('.ai-go')!.disabled = false;
      show(result); talk(D.r[r.tier]);
    };
    root.querySelector('.start')!.addEventListener('click', () => show(steps[0]));
    steps.forEach((st, i) => {
      st.querySelectorAll<HTMLButtonElement>('.opt').forEach((b) => b.addEventListener('click', () => {
        st.querySelectorAll('.opt').forEach((o) => o.classList.remove('picked'));
        b.classList.add('picked'); answers[i] = Number(b.dataset.v);
        dots.forEach((d, k) => d.classList.toggle('on', answers[k] !== null));
        setTimeout(() => (i + 1 < steps.length ? show(steps[i + 1]) : finish()), 320);
      }));
      st.querySelector('.back')?.addEventListener('click', () => show(steps[i - 1]));
    });
    root.querySelector('.again')!.addEventListener('click', () => {
      answers.fill(null); dots.forEach((d) => d.classList.remove('on'));
      root.querySelectorAll('.opt').forEach((o) => o.classList.remove('picked'));
      show(steps[0]);
    });
    root.querySelectorAll('.method-open').forEach((b) => b.addEventListener('click', () => { method.hidden = false; method.scrollTop = 0; }));
    root.querySelector('.mx')!.addEventListener('click', () => (method.hidden = true));

    // detailed evaluation by Carrie (AI): why yes, why not, what to change
    const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]!));
    const render = (md: string) => {
      const html: string[] = []; let list = false;
      for (const raw of md.split('\n')) {
        const line = raw.trim();
        if (!line) { if (list) { html.push('</ul>'); list = false; } continue; }
        const h = line.match(/^#{1,4}\s*(.+)$/) || line.match(/^\*\*(.+?)\*\*:?$/);
        if (h) { if (list) { html.push('</ul>'); list = false; } html.push(`<h4>${esc(h[1])}</h4>`); continue; }
        const b = line.match(/^[-*•]\s+(.+)$/);
        if (b) { if (!list) { html.push('<ul>'); list = true; } html.push(`<li>${esc(b[1]).replace(/\*\*(.+?)\*\*/g, '<b>$1</b>')}</li>`); continue; }
        if (list) { html.push('</ul>'); list = false; }
        html.push(`<p>${esc(line).replace(/\*\*(.+?)\*\*/g, '<b>$1</b>')}</p>`);
      }
      if (list) html.push('</ul>');
      return html.join('');
    };
    const aiBtn = root.querySelector<HTMLButtonElement>('.ai-go')!;
    const out = root.querySelector<HTMLElement>('.ai-out')!, note = root.querySelector<HTMLElement>('.ai-note')!;
    aiBtn.addEventListener('click', async () => {
      if (!last) return;
      aiBtn.disabled = true; out.hidden = false; out.innerHTML = `<p class="wait">${esc(root.dataset.wait || '…')}</p>`;
      const payload = {
        lang: D.lang,
        answers: D.q.map((q: any, i: number) => ({ q: q.t, a: q.opts[answers[i] ?? 0].t })),
        scores: Object.fromEntries(D.dims.map((d: any) => [d.t, Math.round((last!.per[d.id].p / last!.per[d.id].m) * 100)])),
        total: last.pct,
        flags: last.flags.map((f) => D.flags[f]),
      };
      try {
        const r = await fetch('/api/quiz', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) });
        const d = await r.json().catch(() => ({}));
        if (r.ok && d.reply) { out.innerHTML = render(d.reply); note.hidden = false; }
        else { out.textContent = root.dataset.err || 'Try again later.'; aiBtn.disabled = false; }
      } catch { out.textContent = root.dataset.err || 'Try again later.'; aiBtn.disabled = false; }
    });
  }
</script>
