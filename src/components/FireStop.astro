---
// House walk, stop 4: evening by the fireplace. "Ask Carrie": the AI chat about breeding, training, shows and feeding.
import { type Locale, t } from '../i18n';
import ChatPanel from './ChatPanel.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const a = (t(locale) as any).ask;
---
<div class="hstop fstop ask" data-stop="fire" aria-label={a.title}>
  <div class="panel">
    <p class="eyebrow">{a.eyebrow}</p>
    <h2>{a.title}</h2>
    <ChatPanel locale={locale} />
    <p class="note">{a.note}</p>
  </div>
</div>

<style>
  .hstop { position: absolute; inset: 0; z-index: 6; opacity: 0; pointer-events: none; transition: opacity .35s ease; }
  .hstop.live { opacity: 1; pointer-events: auto; }
  .panel { position: absolute; right: max(24px, 4vw); top: calc(var(--hh, 68px) + 20px); bottom: 24px; width: min(520px, 40vw); display: flex; flex-direction: column; gap: 10px; box-sizing: border-box;
    padding: 24px 24px 16px; border-radius: 10px; background: rgba(16,11,7,.78); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); box-shadow: 0 0 0 1px rgba(234,211,154,.18), 0 40px 80px -30px rgba(0,0,0,.8); }
  .panel h2 { font-size: clamp(26px, 2.4vw, 36px); color: var(--ivory); margin: 0 0 4px; }
  .panel :global(.chat) { flex: 1; min-height: 0; grid-template-rows: 1fr auto auto; padding: 0; background: none; box-shadow: none; }
  .panel :global(.log) { height: auto; min-height: 0; }
  .note { margin: 0; font-size: 12px; color: var(--muted-dark); }
  @media (max-width: 899px), (hover: none) {
    .panel { left: 0; right: 0; top: auto; bottom: 0; width: auto; height: 60svh; border-radius: 18px 18px 0 0; padding: 18px 16px calc(12px + env(safe-area-inset-bottom, 0px)); }
    .panel h2 { font-size: 22px; }
    .panel :global(.chips) { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
    .panel :global(.chip) { flex: none; }
    .note { display: none; }
  }
</style>

<script>
  import { mountStop } from '../lib/stop';
  import { headerHeight } from '../lib/frame';
  const el = document.querySelector<HTMLElement>('.fstop');
  if (el) mountStop('fire', el, { onFrame: () => el.style.setProperty('--hh', `${headerHeight()}px`) });
</script>
