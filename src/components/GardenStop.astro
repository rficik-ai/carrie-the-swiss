---
// House walk, stop 3: the garden at golden hour. "Is a Swissy right for you?" Carrie asks, the quiz answers.
import { type Locale, t } from '../i18n';
import GardenQuiz from './GardenQuiz.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const q = (t(locale) as any).quiz;
---
<div class="hstop gstop quiz" data-stop="garden" aria-label={q.title}>
  <div class="layer"><span class="anchor" aria-hidden="true"></span></div>
  <div class="bubble" aria-live="polite">
    <span class="who">{q.eyebrow}</span>
    <p class="say">{q.title}</p>
  </div>
  <div class="qcard"><GardenQuiz locale={locale} /></div>
</div>

<style>
  .hstop { position: absolute; inset: 0; z-index: 6; opacity: 0; pointer-events: none; transition: opacity .35s ease; }
  .hstop.live { opacity: 1; pointer-events: auto; }
  .layer { position: absolute; left: 0; top: 0; width: 1920px; height: 1080px; transform-origin: 0 0; pointer-events: none; }
  .anchor { position: absolute; left: 1395px; top: 250px; width: 1px; height: 1px; }
  /* Carrie's speech bubble, glued next to her head */
  .bubble { position: absolute; z-index: 2; left: 0; top: 0; max-width: min(300px, 24vw); padding: 14px 18px; border-radius: 18px 18px 18px 4px; background: rgba(251,248,241,.95);
    box-shadow: 0 14px 30px -14px rgba(0,0,0,.55); transform: translate(var(--bx, -9999px), var(--by, 0)) translate(0, -100%); transition: opacity .3s; }
  .bubble.bump { animation: bump .45s cubic-bezier(.2,.7,.2,1); }
  @keyframes bump { 0% { scale: .94; } 60% { scale: 1.03; } 100% { scale: 1; } }
  .who { font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--gold-deep); }
  .say { margin: 6px 0 0; font: 600 clamp(16px, 1.3vw, 20px)/1.3 var(--f-display); color: #1c1914; }
  .qcard { position: absolute; left: max(24px, 4vw); top: calc(50% + var(--hh, 68px) / 2); transform: translateY(-50%); max-height: calc(100% - var(--hh, 68px) - 44px); width: min(540px, 40vw); display: block; overflow-y: auto; overscroll-behavior: contain;
    padding: 26px 30px; box-sizing: border-box; background: rgba(251,247,238,.95); color: #1c1914; border-radius: 6px; box-shadow: 0 30px 60px -20px rgba(40,20,0,.6); }
  .qcard :global(.panel) { min-height: 0; }
  .qcard :global(.intro h2) { font-size: clamp(30px, 3vw, 44px); color: #1c1914; }
  .qcard :global(.muted) { color: #5a4a36; }
  .qcard :global(.dots) { margin-top: 20px; }
  .qcard :global(.qhint) { display: block; }
  @media (max-width: 899px), (hover: none) {
    .bubble { display: none; }
    .qcard { left: 0; right: 0; top: auto; bottom: 0; transform: none; width: auto; max-height: 70svh; padding: 20px 18px calc(16px + env(safe-area-inset-bottom, 0px)); border-radius: 18px 18px 0 0; }
    .qcard :global(.intro h2) { font-size: 28px; }
    .qcard :global(.qhint) { font-size: 21px; }
    .qcard :global(.opt) { padding: 12px 14px; font-size: 15px; }
    .qcard :global(.step) { gap: 12px; }
  }
</style>

<script>
  import { mountStop } from '../lib/stop';
  import { headerHeight } from '../lib/frame';
  const el = document.querySelector<HTMLElement>('.gstop');
  if (el) {
    const bubble = el.querySelector<HTMLElement>('.bubble')!;
    mountStop('garden', el, {
      onFrame: (f) => {
        el.style.setProperty('--hh', `${headerHeight()}px`);
        bubble.style.setProperty('--bx', `${f.left + 1395 * f.k}px`);
        bubble.style.setProperty('--by', `${f.top + 250 * f.k}px`);
      },
    });
  }
</script>
