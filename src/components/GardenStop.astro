---
// House walk, stop 3: the garden at golden hour. "Is a Swissy right for you?" Carrie asks, the quiz answers.
import { type Locale, t } from '../i18n';
import GardenQuiz from './GardenQuiz.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const q = (t(locale) as any).quiz;
---
<div class="hstop gstop quiz" data-stop="garden" aria-label={q.title}>
  <div class="layer"><span class="anchor" aria-hidden="true"></span></div>
  {/* what Carrie asks, written beside her head with a thin gold leader line, like a note on a photograph */}
  <div class="bubble" aria-live="polite">
    <svg class="lead" viewBox="0 0 90 60" aria-hidden="true"><path d="M1 59 34 12h55" /><circle cx="1.5" cy="58.5" r="1.5" fill="currentColor" stroke="none"/></svg>
    <div class="txt"><span class="who">{q.eyebrow}</span><p class="say">{q.title}</p></div>
  </div>
  <div class="qshade" aria-hidden="true"></div>
  <div class="qcard"><GardenQuiz locale={locale} /></div>
</div>

<style>
  .hstop { position: absolute; inset: 0; z-index: 6; opacity: 0; pointer-events: none; transition: opacity .35s ease; }
  .hstop.live { opacity: 1; pointer-events: auto; }
  .layer { position: absolute; left: 0; top: 0; width: 1920px; height: 1080px; transform-origin: 0 0; pointer-events: none; }
  .anchor { position: absolute; left: 1395px; top: 250px; width: 1px; height: 1px; }
  /* Carrie's speech bubble, glued next to her head */
  .bubble { position: absolute; z-index: 2; left: 0; top: 0; display: flex; align-items: flex-end; gap: 10px; max-width: min(420px, 30vw); color: var(--gold-hi);
    transform: translate(var(--bx, -9999px), var(--by, 0)) translate(0, -100%); transition: opacity .3s; }
  .lead { flex: none; width: 90px; height: 60px; fill: none; stroke: currentColor; stroke-width: 1.4; filter: drop-shadow(0 1px 6px rgba(0,0,0,.6)); }
  /* a soft dusk behind the words (no edges), so they read over the leaves */
  .txt { display: grid; gap: 4px; padding: 22px 26px 56px; margin: -22px -26px -14px; min-width: 0; background: radial-gradient(110% 100% at 45% 45%, rgba(13,9,4,.66), rgba(13,9,4,0) 72%); }
  .bubble.bump { animation: bump .45s cubic-bezier(.2,.7,.2,1); }
  @keyframes bump { 0% { scale: .94; } 60% { scale: 1.03; } 100% { scale: 1; } }
  .who { font: 300 12px/1 var(--f-head); letter-spacing: .22em; text-transform: uppercase; color: var(--gold-hi); }
  .say { margin: 0; font: 300 clamp(18px, 1.55vw, 26px)/1.22 var(--f-head); letter-spacing: 0; color: #fff; text-shadow: 0 2px 18px rgba(0,0,0,.6); text-wrap: balance; }
  .qcard { position: absolute; left: max(24px, 4vw); top: calc(50% + var(--hh, 68px) / 2); transform: translateY(-50%); max-height: calc(100% - var(--hh, 68px) - 44px); width: min(540px, 40vw); display: block; overflow-y: auto;
    padding: 26px 0; box-sizing: border-box; color: var(--ivory); scrollbar-width: none; }
  .qcard::-webkit-scrollbar { display: none; }
  /* no box: the words lie on the garden, a soft dusk over the left of the picture keeps them readable */
  .qshade { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, rgba(13,9,4,.78) 0%, rgba(13,9,4,.62) 30%, rgba(13,9,4,.25) 50%, rgba(13,9,4,0) 66%); }
  .qcard :global(.panel) { min-height: 0; }
  .qcard :global(.intro h2) { font-size: clamp(24px, 2.3vw, 34px); color: #fff; }
  .qcard :global(.muted) { color: rgba(244,238,226,.82); }
  .qcard :global(.dots) { margin-top: 20px; }
  .qcard :global(.qhint) { display: block; }
  @media (max-width: 899px), (hover: none) {
    .bubble { display: none; }
    .qshade { background: linear-gradient(0deg, rgba(13,9,4,.94) 0%, rgba(13,9,4,.85) 40%, rgba(13,9,4,0) 70%); }
    .qcard { left: 0; right: 0; top: auto; bottom: 0; transform: none; width: auto; max-height: calc(100% - 430px); min-height: 300px; padding: 18px 16px calc(14px + env(safe-area-inset-bottom, 0px)); transition: max-height .45s cubic-bezier(.2,.7,.2,1); }
    .qcard.tall { max-height: calc(100% - var(--hh, 64px) - 130px); }   /* the result needs the room; Carrie has asked her questions */
    .qcard :global(.intro h2) { font-size: 25px; }
    /* phone: the invitation sits centred, the questions stay left */
    .qcard :global(.intro) { justify-items: center; text-align: center; --ko: center; }
    .qcard :global(.intro .row) { justify-content: center; }
    .qcard :global(.intro .kicker::before) { margin-inline: auto; }
    .qcard :global(.qhint) { font-size: 21px; }
    .qcard :global(.opt) { padding: 12px 14px; font-size: 15px; }
    .qcard :global(.step) { gap: 12px; }
  }
</style>

<script>
  import { mountStop } from '../lib/stop';
  import { headerHeight } from '../lib/frame';
  const el = document.querySelector<HTMLElement>('.gstop');
  if (el) {
    const bubble = el.querySelector<HTMLElement>('.bubble')!;
    mountStop('garden', el, {
      onFrame: (f) => {
        el.style.setProperty('--hh', `${headerHeight()}px`);
        bubble.style.setProperty('--bx', `${f.left + 1395 * f.k}px`);
        bubble.style.setProperty('--by', `${f.top + 250 * f.k}px`);
      },
    });
  }
</script>
