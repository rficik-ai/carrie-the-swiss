---
import { type Locale, t } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const q = (t(locale) as any).quiz;
const questions = [1, 2, 3, 4, 5].map((i) => ({ text: q[`q${i}`], opts: [q[`q${i}a`], q[`q${i}b`], q[`q${i}c`]] }));
const results = [1, 2, 3].map((i) => ({ title: q[`r${i}_title`], text: q[`r${i}_text`] }));
---
    <div class="panel" data-reveal data-results={JSON.stringify(results)} data-qlabel={q.q}>
  <div class="step intro">
    <p class="eyebrow">{q.eyebrow}</p>
    <h2>{q.title}</h2>
    <p class="muted">{q.intro}</p>
    <button type="button" class="pill-cta start">{q.start} <span aria-hidden="true">→</span></button>
  </div>

  {questions.map((item, i) => (
    <fieldset class="step question" data-i={i} hidden>
      <legend><span class="qn">{q.q} {i + 1} / {questions.length}</span><span class="qt">{item.text}</span></legend>
      <p class="qhint" aria-hidden="true">{item.text}</p>
      <div class="opts">
        {item.opts.map((o, v) => (
          <button type="button" class="opt" data-v={v}><span class="mark" aria-hidden="true">{['A', 'B', 'C'][v]}</span><span>{o}</span></button>
        ))}
      </div>
    </fieldset>
  ))}

  <div class="step result" hidden>
    <p class="eyebrow">{q.eyebrow}</p>
    <p class="rtitle"></p>
    <p class="rtext muted"></p>
    <div class="ractions">
      <a class="pill-cta" href={`/${locale}/#episodes`} data-open-book="01">{q.watch} <span aria-hidden="true">→</span></a>
      <button type="button" class="again">{q.again} ↻</button>
    </div>
  </div>

  <div class="dots" aria-hidden="true">{questions.map(() => <i></i>)}</div>
</div>

<style>
  .panel { position: relative; min-height: 420px; display: grid; align-content: center; }
  .step { display: grid; gap: 18px; border: 0; margin: 0; padding: 0; min-width: 0; animation: enter .5s cubic-bezier(.2,.7,.2,1); }
  .step[hidden] { display: none; }
  @keyframes enter { from { opacity: 0; transform: translateX(24px); } to { opacity: 1; transform: none; } }
  .intro h2 { font-size: clamp(36px, 5vw, 64px); }
  .intro .start, .ractions .pill-cta { justify-self: start; border: 0; cursor: pointer; font-family: var(--f-body); }
  legend { display: grid; gap: 10px; padding: 0; margin-bottom: 8px; }
  .qn { font-size: 12px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--gold-deep); }
  .qt { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .qhint { margin: 0; font: 600 clamp(22px, 2.2vw, 30px)/1.2 var(--f-display); color: #1c1914; }
  @media (min-width: 960px) { .qhint { display: none; } }
  .opts { display: grid; gap: 12px; }
  .opt { display: flex; align-items: center; gap: 16px; width: 100%; text-align: left; padding: 16px 18px; border-radius: 14px; border: 1px solid rgba(138,100,36,.3); background: #fffdf8; color: #1c1914; font: 600 16px var(--f-body); cursor: pointer;
    transition: transform .25s cubic-bezier(.2,.7,.2,1), border-color .25s, box-shadow .25s, background .25s; }
  .opt:hover, .opt:focus-visible { transform: translateX(6px); border-color: var(--gold); box-shadow: 0 12px 26px -16px rgba(138,100,36,.6); outline: none; }
  .opt.picked { background: var(--gold); border-color: var(--gold); }
  .mark { flex: none; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; font: 600 15px var(--f-display); color: var(--gold-deep); border: 1px solid rgba(138,100,36,.45); }
  .opt.picked .mark { background: #1a1408; color: var(--gold-hi); border-color: #1a1408; }
  .rtitle { margin: 0; font: 600 clamp(32px, 3.8vw, 52px)/1.1 var(--f-display); color: #1c1914; }
  .rtext { margin: 0; font-size: 18px; max-width: 32em; }
  .ractions { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; margin-top: 8px; }
  .again { background: none; border: 0; cursor: pointer; font: 700 15px var(--f-body); color: var(--gold-deep); }
  .dots { display: flex; gap: 8px; margin-top: 30px; }
  .dots i { width: 28px; height: 4px; border-radius: 4px; background: rgba(138,100,36,.2); transition: background .4s; }
  .dots i.on { background: var(--gold); }
</style>

<script>
  const panel = document.querySelector<HTMLElement>('.quiz .panel');
  if (panel) {
    const steps = [...panel.querySelectorAll<HTMLElement>('.question')];
    const intro = panel.querySelector<HTMLElement>('.intro')!;
    const result = panel.querySelector<HTMLElement>('.result')!;
    const dots = [...panel.querySelectorAll<HTMLElement>('.dots i')];
    const results = JSON.parse(panel.dataset.results!);
    const bubble = document.querySelector<HTMLElement>('.quiz .bubble')!;
    const say = bubble.querySelector<HTMLElement>('.say')!;
    const initialSay = say.textContent;
    let score = 0;
    const talk = (txt: string) => { say.textContent = txt; bubble.classList.remove('bump'); void bubble.offsetWidth; bubble.classList.add('bump'); };
    const show = (el: HTMLElement) => {
      [intro, result, ...steps].forEach((s) => (s.hidden = s !== el));
      const q = el.querySelector<HTMLElement>('.qt');
      if (q) talk(q.textContent!);
      el.querySelector<HTMLElement>('.opt, .start, .pill-cta')?.focus({ preventScroll: true });
    };
    panel.querySelector('.start')!.addEventListener('click', () => { score = 0; show(steps[0]); });
    steps.forEach((st, i) => {
      st.querySelectorAll<HTMLButtonElement>('.opt').forEach((b) => b.addEventListener('click', () => {
        st.querySelectorAll('.opt').forEach((o) => o.classList.remove('picked'));
        b.classList.add('picked');
        score += Number(b.dataset.v);
        dots[i].classList.add('on');
        setTimeout(() => {
          if (i + 1 < steps.length) show(steps[i + 1]);
          else {
            const r = results[score <= 4 ? 0 : score <= 7 ? 1 : 2];
            result.querySelector('.rtitle')!.textContent = r.title;
            result.querySelector('.rtext')!.textContent = r.text;
            show(result);
            talk(r.text);
          }
        }, 380);
      }));
    });
    panel.querySelector('.again')!.addEventListener('click', () => {
      score = 0; dots.forEach((d) => d.classList.remove('on'));
      panel.querySelectorAll('.opt').forEach((o) => o.classList.remove('picked'));
      talk(initialSay!); show(steps[0]);
    });
  }
</script>
